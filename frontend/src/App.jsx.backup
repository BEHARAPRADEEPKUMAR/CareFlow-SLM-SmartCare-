          <strong>
            CareFlow
          </strong>

          <span>
            HEALTHCARE INTELLIGENCE
          </span>
        </div>

      </div>

      <div className="dashboard-user">

        <div className="online-status">
          <span></span>
          AI Online
        </div>

        <div className={`user-avatar ${user?.role === "doctor" ? "user-avatar-photo" : ""}`}>
          {user?.role === "doctor" ? (
            <img
              src={DEMO_DOCTORS.find((doctor) => (user?.name || "").toLowerCase().includes(doctor.name.toLowerCase()))?.photo || "/doctors/dr-arjun-mehta.png"}
              alt={`Dr. ${user?.name || "Doctor"}`}
              onError={(event) => { event.currentTarget.style.display = "none"; event.currentTarget.parentElement.textContent = (user?.name || "DR").split(" ").map((part) => part[0]).join("").slice(0, 2); }}
            />
          ) : (user?.name || "U").split(" ").map((part) => part[0]).join("").slice(0, 2)}
        </div>

        <div className="user-info">

          <strong>
            {user?.role === "doctor"
              ? `Dr. ${user?.name}`
              : user?.name ||
                "Patient"}
          </strong>

          <span>
            {user?.role === "doctor"
              ? "DOCTOR"
              : "PATIENT"}
          </span>

        </div>

        <button
          className="logout-button"
          onClick={onLogout}
        >
          Logout
        </button>

      </div>

    </header>
  );
}

/* =========================================================
   PATIENT DASHBOARD
   ========================================================= */

function PatientDashboard({
  user,
  onLogout,
}) {
  const [activeSection, setActiveSection] =
    useState("overview");

  const [appointments, setAppointments] =
    useState([]);

  const [loadingAppointments, setLoadingAppointments] =
    useState(true);

  async function loadAppointments() {
    setLoadingAppointments(true);

    try {
      const data =
        await apiRequest(
          "/api/appointments/"
        );

      setAppointments(
        normalizeListResponse(data)
      );
    } catch (error) {
      if (error.status === 401) {
        onLogout();
      }
    } finally {
      setLoadingAppointments(false);
    }
  }

  useEffect(() => {
    loadAppointments();
  }, []);

  return (
    <div className="dashboard-page">

      <DashboardTopbar
        user={user}
        onLogout={onLogout}
      />

      <div className="dashboard-shell">

        {/* =================================================
            SIDEBAR
            ================================================= */}

        <aside className="dashboard-sidebar">

          <div className="sidebar-welcome">
            <span>
              PATIENT PORTAL
            </span>

            <strong>
              Welcome,
              <br />
              {user?.name}
            </strong>
          </div>

          <nav className="dashboard-nav">

            <DashboardNavButton
              active={
                activeSection ===
                "overview"
              }
              onClick={() =>
                setActiveSection(
                  "overview"
                )
              }
              icon="⌂"
              label="Overview"
            />

            <DashboardNavButton
              active={
                activeSection ===
                "appointments"
              }
              onClick={() =>
                setActiveSection(
                  "appointments"
                )
              }
              icon="▣"
              label="Your Appointments"
            />

            <DashboardNavButton
              active={
                activeSection ===
                "ai"
              }
              onClick={() =>
                setActiveSection("ai")
              }
              icon="✦"
              label="AI Chatbot"
            />

            <DashboardNavButton
              active={
                activeSection ===
                "services"
              }
              onClick={() =>
                setActiveSection(
                  "services"
                )
              }
              icon="✚"
              label="Hospital Services"
            />

            <DashboardNavButton
              active={
                activeSection ===
                "doctors"
              }
              onClick={() =>
                setActiveSection(
                  "doctors"
                )
              }
              icon="◉"
              label="Doctors & Specializations"
            />

          </nav>

          <div className="sidebar-ai-card">

            <div className="sidebar-ai-icon">
              ✦
            </div>

            <strong>
              CareFlow AI
            </strong>

            <p>
              Ask me about appointments,
              doctors and hospital services.
            </p>

            <button
              onClick={() =>
                setActiveSection("ai")
              }
            >
              Open AI →
            </button>

          </div>

        </aside>

        {/* =================================================
            MAIN CONTENT
            ================================================= */}

        <main className="dashboard-main">

          {activeSection ===
            "overview" && (
            <PatientOverview
              user={user}
              appointments={
                appointments
              }
              loading={
                loadingAppointments
              }
              onOpenAI={() =>
                setActiveSection("ai")
              }
              onOpenAppointments={() =>
                setActiveSection(
                  "appointments"
                )
              }
            />
          )}

          {activeSection ===
            "appointments" && (
            <PatientAppointments
              appointments={
                appointments
              }
              loading={
                loadingAppointments
              }
              onRefresh={
                loadAppointments
              }
            />
          )}

          {activeSection ===
            "ai" && (
            <PatientAI
              appointments={appointments}
              appointmentsLoading={loadingAppointments}
              onAppointmentsUpdated={loadAppointments}
            />
          )}

          {activeSection ===
            "services" && (
            <PatientServices />
          )}

          {activeSection ===
            "doctors" && (
            <PatientDoctors />
          )}

        </main>

      </div>

    </div>
  );
}

/* =========================================================
   DASHBOARD NAV BUTTON
   ========================================================= */

function DashboardNavButton({
  active,
  onClick,
  icon,
  label,
}) {
  return (
    <button
      className={`dashboard-nav-button ${
        active ? "active" : ""
      }`}
      onClick={onClick}
    >
      <span className="dashboard-nav-icon">
        {icon}
      </span>

      <span>
        {label}
      </span>
    </button>
  );
}

/* =========================================================
   PATIENT OVERVIEW
   ========================================================= */

function isUpcomingAppointment(appointment) {
  const status = String(appointment?.status || "").toUpperCase();
  if (!["SCHEDULED", "CONFIRMED", "RESCHEDULED"].includes(status)) return false;

  const dateValue = appointment?.appointment_date || appointment?.date;
  const timeValue = appointment?.appointment_time || appointment?.time;
  if (!dateValue) return false;

  const dateText = String(dateValue).slice(0, 10);
  const timeText = String(timeValue || "23:59:59").slice(0, 8);
  const scheduled = new Date(`${dateText}T${timeText}`);
  if (Number.isNaN(scheduled.getTime())) return false;
  return scheduled.getTime() > Date.now();
}

function PatientOverview({
  user,
  appointments,
  loading,
  onOpenAI,
  onOpenAppointments,
}) {
  const upcoming = appointments
    .filter(isUpcomingAppointment)
    .sort((a, b) => {
      const aDate = `${a.appointment_date || a.date}T${a.appointment_time || a.time || "23:59:59"}`;
      const bDate = `${b.appointment_date || b.date}T${b.appointment_time || b.time || "23:59:59"}`;
      return new Date(aDate) - new Date(bDate);
    });

  const nextAppointment =
    upcoming[0];

  return (
    <>
      <div className="dashboard-heading">

        <div>
          <span className="section-label">
            PATIENT DASHBOARD
          </span>

          <h1>
            Hello,{" "}
            <span>
              {user?.name}
            </span>
          </h1>

          <p>
            Manage your healthcare journey
            with CareFlow.
          </p>
        </div>

        <button
          className="dashboard-ai-button"
          onClick={onOpenAI}
        >
          ✦ Ask CareFlow AI
        </button>

      </div>

      <div className="overview-stat-grid">

        <StatCard
          icon="▣"
          value={
            appointments.length
          }
          label="Total appointments"
        />

        <StatCard
          icon="◷"
          value={
            upcoming.length
          }
          label="Upcoming appointments"
        />

        <StatCard
          icon="✦"
          value="24/7"
          label="AI assistance"
        />

      </div>

      <div className="overview-grid">

        <div className="dashboard-card">

          <div className="card-header">

            <div>
              <span className="section-label">
                NEXT APPOINTMENT
              </span>

              <h2>
                Your upcoming visit
              </h2>
            </div>

            <button
              className="text-button"
              onClick={
                onOpenAppointments
              }
            >
              View all →
            </button>

          </div>

          {loading ? (
            <LoadingBox text="Loading appointments..." />
          ) : nextAppointment ? (
            <AppointmentPreview
              appointment={
                nextAppointment
              }
            />
          ) : (
            <EmptyState
              icon="▣"
              title="No upcoming appointments"
              description="Use CareFlow AI to find a doctor and book your next appointment."
            />
          )}

        </div>

        <div className="dashboard-card">

          <div className="card-header">

            <div>
              <span className="section-label">
                CAREFLOW AI
              </span>

              <h2>
                Need help?
              </h2>
            </div>

            <div className="small-ai-status">
              <span></span>
              Online
            </div>

          </div>

          <p className="card-description">
            Ask CareFlow AI to find a doctor,
            check appointment availability,
            answer hospital questions or help
            manage your appointments.
          </p>

          <button
            className="large-ai-button"
            onClick={onOpenAI}
          >
            <span>
              ✦
            </span>

            Open AI Assistant

            <strong>
              →
            </strong>
          </button>

        </div>

      </div>

      <div className="dashboard-card services-preview-card">

        <div className="card-header">

          <div>
            <span className="section-label">
              HOSPITAL SERVICES
            </span>

            <h2>
              Healthcare services
            </h2>
          </div>

        </div>

        <div className="mini-services-grid">

          {HOSPITAL_SERVICES
            .slice(0, 4)
            .map((service) => (
              <div
                className="mini-service"
                key={service.title}
              >

                <div className="mini-service-icon">
                  {service.icon}
                </div>

                <div>
                  <strong>
                    {service.title}
                  </strong>

                  <span>
                    {service.description}
                  </span>
                </div>

              </div>
            ))}

        </div>

      </div>
    </>
  );
}

/* =========================================================
   STAT CARD
   ========================================================= */

function StatCard({
  icon,
  value,
  label,
}) {
  return (
    <div className="stat-card">

      <div className="stat-icon">
        {icon}
      </div>

      <div>
        <strong>
          {value}
        </strong>

        <span>
          {label}
        </span>
      </div>

    </div>
  );
}

/* =========================================================
   APPOINTMENT PREVIEW
   ========================================================= */

function AppointmentPreview({
  appointment,
}) {
  return (
    <div className="appointment-preview">

      <div className="appointment-date-box">

        <span>
          {appointment.appointment_date
            ? new Date(
                appointment.appointment_date
              ).toLocaleDateString(
                "en-IN",
                {
                  month: "short",
                }
              )
            : "---"}
        </span>

        <strong>
          {appointment.appointment_date
            ? new Date(
                appointment.appointment_date
              ).getDate()
            : "--"}
        </strong>

      </div>

      <div className="appointment-preview-info">

        <span className="appointment-specialty">
          {appointment.department_name ||
            "Healthcare"}
        </span>

        <h3>
          Dr.{" "}
          {appointment.doctor_name ||
            "Doctor"}
        </h3>

        <p>
          {formatTime(
            appointment.appointment_time
          )}
        </p>

      </div>

      <StatusBadge
        status={
          appointment.status
        }
      />

    </div>
  );
}

/* =========================================================
   PATIENT APPOINTMENTS
   ========================================================= */

function PatientAppointments({
  appointments,
  loading,
  onRefresh,
}) {
  return (
    <>
      <div className="dashboard-heading">

        <div>
          <span className="section-label">
            PATIENT PORTAL
          </span>

          <h1>
            Your{" "}
            <span>
              Appointments
            </span>
          </h1>

          <p>
            View and manage your scheduled
            healthcare appointments.
          </p>
        </div>

        <button
          className="refresh-button"
          onClick={onRefresh}
        >
          ↻ Refresh
        </button>

      </div>

      <div className="dashboard-card">

        {loading ? (
          <LoadingBox text="Loading your appointments..." />
        ) : appointments.length ===
          0 ? (
          <EmptyState
            icon="▣"
            title="No appointments yet"
            description="Use CareFlow AI to find a doctor and book an appointment."
          />
        ) : (
          <AppointmentList
            appointments={
              appointments
            }
          />
        )}

      </div>
    </>
  );
}

/* =========================================================
   APPOINTMENT LIST
   ========================================================= */

function AppointmentList({
  appointments,
}) {
  return (
    <div className="appointment-list">

      {appointments.map(
        (appointment) => (
          <div
            className="appointment-row"
            key={
              appointment.id ||
              appointment.appointment_id
            }
          >

            <div className="appointment-row-date">

              <strong>
                {formatDate(
                  appointment.appointment_date
                )}
              </strong>

              <span>
                {formatTime(
                  appointment.appointment_time
                )}
              </span>

            </div>

            <div className="appointment-row-doctor">

              <div className="table-avatar">
                {(appointment.doctor_name ||
                  "D")
                  .split(" ")
                  .map((part) =>
                    part[0]
                  )
                  .join("")
                  .slice(0, 2)}
              </div>

              <div>

                <strong>
                  Dr.{" "}
                  {appointment.doctor_name ||
                    "Doctor"}
                </strong>

                <span>
                  {appointment.department_name ||
                    "Healthcare"}
                </span>

              </div>

            </div>

            <div className="appointment-row-reason">

              <span>
                Reason
              </span>

              <p>
                {appointment.reason ||
                  "General appointment"}
              </p>

            </div>

            <StatusBadge
              status={
                appointment.status
              }
            />

          </div>
        )
      )}

    </div>
  );
}

/* =========================================================
   STATUS BADGE
   ========================================================= */

function StatusBadge({
  status,
}) {
  const normalized =
    String(
      status || "SCHEDULED"
    ).toUpperCase();

  return (
    <span
      className={`status-badge status-${normalized.toLowerCase()}`}
    >
      {normalized}
    </span>
  );
}

/* =========================================================
   PATIENT SERVICES
   ========================================================= */

function PatientServices() {
  return (
    <>
      <div className="dashboard-heading">

        <div>
          <span className="section-label">
            CAREFLOW HOSPITAL
          </span>

          <h1>
            Hospital{" "}
            <span>
              Services
            </span>
          </h1>

          <p>
            Explore the healthcare services available
            through CareFlow.
          </p>
        </div>

      </div>

      <div className="services-grid dashboard-services">

        {HOSPITAL_SERVICES.map(
          (service) => (
            <div
              className="service-card"
              key={service.title}
            >

              <div className="service-icon">
                {service.icon}
              </div>

              <h3>
                {service.title}
              </h3>

              <p>
                {service.description}
              </p>

            </div>
          )
        )}

      </div>
    </>
  );
}

/* =========================================================
   PATIENT DOCTORS
   ========================================================= */

function PatientDoctors() {
  const [
    selectedSpecialization,
    setSelectedSpecialization,
  ] = useState("All");

  const doctors = useMemo(() => {
    if (
      selectedSpecialization ===
      "All"
    ) {
      return DEMO_DOCTORS;
    }

    return DEMO_DOCTORS.filter(
      (doctor) =>
        doctor.specialization ===
        selectedSpecialization
    );
  }, [
    selectedSpecialization,
  ]);

  return (
    <>
      <div className="dashboard-heading">

        <div>
          <span className="section-label">
            CAREFLOW HOSPITAL
          </span>

          <h1>
            Doctors &{" "}
            <span>
              Specializations
            </span>
          </h1>

          <p>
            Explore our doctors and medical
            specializations.
          </p>
        </div>

      </div>

      <div className="specialization-filter">

        <button
          className={
            selectedSpecialization ===
            "All"
              ? "filter-button active"
              : "filter-button"
          }
          onClick={() =>
            setSelectedSpecialization(
              "All"
            )
          }
        >
          All Doctors
        </button>

        {SPECIALIZATIONS.map(
          (specialization) => (
            <button
              key={
                specialization.name
              }
              className={
                selectedSpecialization ===
                specialization.name
                  ? "filter-button active"
                  : "filter-button"
              }
              onClick={() =>
                setSelectedSpecialization(
                  specialization.name
                )
              }
            >
              {
                specialization.name
              }
            </button>
          )
        )}

      </div>

      <div className="doctor-grid dashboard-doctor-grid">

        {doctors.map((doctor) => (
          <DoctorCard
            doctor={doctor}
            key={doctor.id}
          />
        ))}

      </div>
    </>
  );
}

/* =========================================================
   PATIENT AI CHATBOT
   IMPORTANT:
   AVAILABLE SLOTS ARE RENDERED INSIDE CHAT.
   THERE IS NO SEPARATE AVAILABLE SLOTS SECTION.
   ========================================================= */

function PatientAI({
  appointments = [],
  appointmentsLoading = false,
  onAppointmentsUpdated,
}) {
  const [messages, setMessages] =
    useState([
      {
        id: 1,
        role: "assistant",
        text:
          "Hello! I’m CareFlow AI. I can help you find doctors, check appointment availability, book appointments, and answer hospital-related questions.",
      },
    ]);

  const [input, setInput] =
    useState("");

  const [loading, setLoading] =
    useState(false);

  const [booking, setBooking] =
    useState(false);

  const [selectedSlot, setSelectedSlot] = useState(null);
  const [rescheduleMode, setRescheduleMode] = useState(false);

  const messagesEndRef = useRef(null);
  const chatMessagesRef = useRef(null);

  // Keep scrolling inside the conversation pane. Avoid scrollIntoView(),
  // which can move the entire dashboard page and hide the composer.
  useEffect(() => {
    const pane = chatMessagesRef.current;
    if (!pane) return;
    pane.scrollTo({
      top: pane.scrollHeight,
      behavior: window.matchMedia?.("(prefers-reduced-motion: reduce)").matches
        ? "auto"
        : "smooth",
    });
  }, [messages, loading]);

  // Personalize the initial greeting after the patient's appointments load.
  useEffect(() => {
    if (appointmentsLoading || messages.length !== 1) return;
    const upcoming = appointments.filter(isUpcomingAppointment);
    setMessages([{
      id: 1,
      role: "assistant",
      text: upcoming.length
        ? `Welcome back! You have ${upcoming.length} upcoming appointment${upcoming.length === 1 ? "" : "s"}. You can ask me to show the details, find available slots, or manage an appointment.`
        : "Welcome to CareFlow AI. You don't have any upcoming appointments right now. If you'd like to book a visit, tell me which doctor or department you need, and I'll help you find an available slot.",
    }]);
  }, [appointments, appointmentsLoading]);

  // Secure backend confirmation returned after an AI action
  // asks the patient to confirm (for example, cancellation).
  const [pendingConfirmation, setPendingConfirmation] =
    useState(null);

  async function sendMessage(event) {
    if (event) {
      event.preventDefault();
    }

    const text =
      input.trim();

    if (!text || loading) {
      return;
    }

    const requestedMinutes =
      parseRequestedTime(text);

    setInput("");
    setSelectedSlot(null);

    setMessages(
      (current) => [
        ...current,
        {
          id: Date.now(),
          role: "user",
          text,
        },
      ]
    );

    // Answer appointment-list requests from the authenticated patient's
    // already-loaded appointment data, so the answer is accurate and immediate.
    const normalizedRequest = text.toLowerCase();

    const asksToManageAppointment =
      /\b(reschedule|reshedule|cancel|move|shift|postpone)\b/i.test(text);

    const asksUpcoming =
      !asksToManageAppointment &&
      /(upcoming|next|future).{0,35}appointments?|appointments?.{0,35}(upcoming|next|future)|show my appointments|my appointments/.test(normalizedRequest);
        if (asksUpcoming) {
          if (appointmentsLoading) {
            setLoading(true);
            setMessages((current) => [...current, {
              id: Date.now() + 1,
              role: "assistant",
              text: "I'm checking your appointments. Please try that request again in a moment.",
            }]);
            setLoading(false);
            return;
          }

      const upcoming = appointments
        .filter(isUpcomingAppointment)
        .sort((a, b) => {
          const aDate = `${a.appointment_date || a.date}T${a.appointment_time || a.time || "23:59:59"}`;
          const bDate = `${b.appointment_date || b.date}T${b.appointment_time || b.time || "23:59:59"}`;
          return new Date(aDate) - new Date(bDate);
        });

      const appointmentSummary = upcoming.length
        ? `Here ${upcoming.length === 1 ? "is your upcoming appointment" : "are your upcoming appointments"}:\n\n${upcoming.map((appointment, index) => {
            const doctor = appointment.doctor_name || appointment.doctor?.name || appointment.doctor?.full_name || "your doctor";
            const department = appointment.department_name || appointment.department || appointment.doctor?.department?.name;
            const date = formatDate(appointment.appointment_date || appointment.date);
            const time = formatTime(appointment.appointment_time || appointment.time);
            return `${index + 1}. Dr. ${String(doctor).replace(/^Dr\.?\s*/i, "")} — ${date} at ${time}${department ? ` (${department})` : ""}\n   Status: ${String(appointment.status || "SCHEDULED").toLowerCase()}`;
          }).join("\n\n")}\n\nWould you like help rescheduling or booking another appointment?`
        : "You don't have any upcoming appointments right now. If you'd like to book one, tell me the doctor or department you prefer (for example, Cardiology), and I'll show you available slots.";

      setMessages((current) => [...current, {
        id: Date.now() + 1,
        role: "assistant",
        text: appointmentSummary,
      }]);
      setPendingConfirmation(null);
      return;
    }

    setLoading(true);

    try {
      const requestBody = {
        message: text,
      };

      // Only send a confirmation token for an explicit Yes/No
      // reply to the pending confirmation. A new normal request
      // starts a fresh chatbot turn.
      const normalizedReply = text.toLowerCase();
      const isConfirmationReply = [
        "yes",
        "yes please",
        "y",
        "confirm",
        "confirmed",
        "sure",
        "okay",
        "ok",
        "no",
        "nope",
        "cancel",
        "don't",
        "do not",
      ].includes(normalizedReply);

      if (pendingConfirmation && isConfirmationReply) {
        requestBody.confirmation = pendingConfirmation;
      } else if (pendingConfirmation) {
        setPendingConfirmation(null);
      }

      const data =
        await apiRequest(
          "/api/chat/",
          {
            method: "POST",
            body: JSON.stringify(requestBody),
          }
        );

      const responseText =
        extractChatText(data) ||
        "I found information related to your request.";

      const rawOptions =
        getBookingOptions(data);

      const rankedOptions =
        rankBookingOptions(
          rawOptions,
          requestedMinutes
        );
      const returnedIntent = String(
        data?.intent || data?.result?.intent || ""
      ).toUpperCase();

      const returnedAction = String(
        data?.action || data?.result?.action || ""
      ).toUpperCase();

      if (
        returnedIntent === "RESCHEDULE_APPOINTMENT" ||
        returnedAction.startsWith("RESCHEDULE")
      ) {
        setRescheduleMode(true);
      } else if (
        returnedIntent === "BOOK_APPOINTMENT" ||
        returnedAction === "AVAILABLE_SLOTS"
      ) {
        setRescheduleMode(false);
      }

      // Save a backend-issued confirmation token so a bare
      // "Yes" can safely execute only the action that was
      // explicitly shown to the patient.
      if (data?.confirmation) {
        setPendingConfirmation(data.confirmation);
      } else {
        setPendingConfirmation(null);
      }

      setMessages(
        (current) => [
          ...current,
          {
            id: Date.now() + 1,
            role: "assistant",
            text: responseText,
            bookingOptions:
              rankedOptions,
          },
        ]
      );
    } catch (error) {
      setPendingConfirmation(null);

      setMessages(
        (current) => [
          ...current,
          {
            id: Date.now() + 1,
            role: "assistant",
            text:
              error.status === 401
                ? "Your session has expired. Please log in again."
                : extractErrorMessage(
                    error
                  ),
          },
        ]
      );
    } finally {
      setLoading(false);
    }
  }

  function selectSlot(slot) {
    setSelectedSlot(slot);
  }

  async function confirmBooking() {
    if (!selectedSlot || booking) {
      return;
    }

    setBooking(true);

    try {
      const doctorId = slotDoctorId(selectedSlot);
      const date = normalizeSlotDate(slotDate(selectedSlot));
      const time = normalizeSlotTime(slotTime(selectedSlot));

      if (!doctorId || !date || !time) {
        throw new Error("The selected appointment slot is incomplete.");
      }

      // Rescheduling must go through the chatbot's confirmation flow.
      // Do not create a second appointment with POST /api/appointments/.
      if (rescheduleMode) {
        const data = await apiRequest("/api/chat/", {
          method: "POST",
          body: JSON.stringify({
            message: `Reschedule my appointment to ${date} at ${time}`,
          }),
        });

        const responseText =
          extractChatText(data) ||
          "I couldn't process that rescheduling request.";

        if (data?.confirmation) {
          setPendingConfirmation(data.confirmation);
        } else {
          setPendingConfirmation(null);
        }

        setMessages((current) => [
          ...current,
          {
            id: Date.now(),
            role: "assistant",
            text: responseText,
            bookingOptions: [],
          },
        ]);

        // Keep reschedule mode active until the backend confirms
        // the update, or the patient starts a new booking request.
        setSelectedSlot(null);
        return;
      }

      // Normal new appointment booking remains unchanged.
      const appointment = await apiRequest("/api/appointments/", {
        method: "POST",
        body: JSON.stringify({
          doctor: Number(doctorId),
          appointment_date: date,
          appointment_time: time,
          status: "SCHEDULED",
          reason: "Booked through CareFlow AI",
        }),
      });

      setMessages((current) => [
        ...current,
        {
          id: Date.now(),
          role: "assistant",
          text: `Appointment confirmed with Dr. ${slotDoctorName(
            selectedSlot
          )} on ${formatDate(date)} at ${formatTime(time)}. Appointment ID: ${
            appointment?.appointment_id || appointment?.id || "confirmed"
          }.`,
        },
      ]);

      setSelectedSlot(null);
      setRescheduleMode(false);

      if (onAppointmentsUpdated) {
        onAppointmentsUpdated();
      }
    } catch (error) {
      setMessages((current) => [
        ...current,
        {
          id: Date.now(),
          role: "assistant",
          text: `I could not complete the ${
            rescheduleMode ? "rescheduling" : "booking"
          }. ${extractErrorMessage(error)}`,
        },
      ]);
    } finally {
      setBooking(false);
    }
  }

  return (
    <>
      {/* =====================================================
          CHAT PAGE HEADER
          ===================================================== */}

      <div className="dashboard-heading">

        <div>

          <span className="section-label">
            CAREFLOW AI
          </span>

          <h1>
            AI{" "}
            <span>
              Chatbot
            </span>
          </h1>

          <p>
            Tell me what you need in natural language.
          </p>

        </div>

        <div className="ai-status-pill">
          <span></span>
          AI Assistant Online
        </div>

      </div>

      {/* =====================================================
          CHAT LAYOUT
          ===================================================== */}

      <div className="ai-chat-layout careflow-chat-layout">

        <div className="chat-card">

          {/* CHAT HEADER */}

          <div className="chat-header">

            <div className="ai-icon robot-avatar" aria-label="CareFlow AI robot">
              <span role="img" aria-label="robot">🤖</span>
            </div>

            <div className="chat-header-text">

              <strong>
                CareFlow AI Assistant
              </strong>

              <span>
                Appointment & hospital communication
              </span>

            </div>

            <div className="online-dot"></div>

          </div>

          {/* =================================================
              CHAT MESSAGES
              ================================================= */}

          <div className="chat-messages" ref={chatMessagesRef}>

            {messages.map(
              (message) => (
                <div
                  key={message.id}
                  className={`chat-message ${
                    message.role ===
                    "user"
                      ? "chat-message-user"
                      : "chat-message-ai"
                  }`}
                >

                  {/* MESSAGE */}

                  <div className="message-bubble">

                    {message.role ===
                      "assistant" && (
                      <div className="message-ai-icon robot-avatar" aria-label="CareFlow AI robot">
                        <span role="img" aria-label="robot">🤖</span>
                      </div>
                    )}

                    <div className="message-content">
                      {message.text}
                    </div>

                  </div>

                  {/* =================================================
                      BOOKING OPTIONS
                      THEY ARE INSIDE THE CHAT MESSAGE
                      ================================================= */}

                  {message.role ===
                    "assistant" &&
                    Array.isArray(
                      message.bookingOptions
                    ) &&
                    message.bookingOptions
                      .length > 0 && (
                      <div className="chat-booking-options">

                        <div className="chat-booking-title">

                          <div>

                            <span>
                              AVAILABLE SLOTS
                            </span>

                            <strong>
                              Choose a doctor and time
                            </strong>

                          </div>

                          <small>
                            {
                              message
                                .bookingOptions
                                .length
                            }{" "}
                            relevant slots
                          </small>

                        </div>

                        <div className="chat-slot-grid">

                          {message.bookingOptions.map(
                            (
                              slot,
                              index
                            ) => {
                              const doctorName =
                                slotDoctorName(
                                  slot
                                );

                              const department =
                                slotDepartment(
                                  slot
                                );

                              const date =
                                slotDate(
                                  slot
                                );

                              const time =
                                slotTime(
                                  slot
                                );

                              const fee =
                                slotFee(
                                  slot
                                );

                              const isSelected =
                                selectedSlot &&
                                String(
                                  slotDoctorId(
                                    selectedSlot
                                  )
                                ) ===
                                  String(
                                    slotDoctorId(
                                      slot
                                    )
                                  ) &&
                                normalizeSlotDate(
                                  slotDate(
                                    selectedSlot
                                  )
                                ) ===
                                  normalizeSlotDate(
                                    date
                                  ) &&
                                normalizeSlotTime(
                                  slotTime(
                                    selectedSlot
                                  )
                                ) ===
                                  normalizeSlotTime(
                                    time
                                  );

                              return (
                                <div
                                  key={`${slotDoctorId(
                                    slot
                                  )}-${date}-${time}-${index}`}
                                  className={`chat-slot-card ${
                                    isSelected
                                      ? "chat-slot-selected"
                                      : ""
                                  }`}
                                >

                                  <div className="chat-slot-top">

                                    <span className="slot-period">
                                      {
                                        formatTime(
                                          time
                                        ).split(
                                          " "
                                        )[1]
                                      }
                                    </span>

                                    {isSelected && (
                                      <span className="slot-selected-badge">
                                        ✓ Selected
                                      </span>
                                    )}

                                  </div>

                                  <div className="chat-slot-doctor">
                                    Dr.{" "}
                                    {
                                      doctorName
                                    }
                                  </div>

                                  <div className="chat-slot-department">
                                    {
                                      department
                                    }
                                  </div>

                                  <div className="chat-slot-date">
                                    {
                                      formatDate(
                                        date
                                      )
                                    }
                                  </div>

                                  <div className="chat-slot-time">
                                    {
                                      formatTime(
                                        time
                                      )
                                    }
                                  </div>

                                  {fee !==
                                    null &&
                                    fee !==
                                      undefined &&
                                    fee !==
                                      "" && (
                                      <div className="chat-slot-fee">
                                        {
                                          formatFee(
                                            fee
                                          )
                                        }
                                      </div>
                                    )}

                                  <button
                                    type="button"
                                    className={
                                      isSelected
                                        ? "chat-slot-button selected"
                                        : "chat-slot-button"
                                    }
                                    onClick={() =>
                                      selectSlot(
                                        slot
                                      )
                                    }
                                  >
                                    {isSelected
                                      ? "Selected ✓"
                                      : "Select this slot →"}
                                  </button>

                                </div>
                              );
                            }
                          )}

                        </div>

                        {/* =================================================
                            CONFIRMATION
                            ================================================= */}

                        {selectedSlot && (
                          <div className="booking-confirm-panel">

                            <div className="booking-confirm-info">

                              <div className="booking-confirm-icon">
                                ✓
                              </div>

                              <div>

                                <span>
                                  SELECTED APPOINTMENT
                                </span>

                                <strong>
                                  Dr.{" "}
                                  {
                                    slotDoctorName(
                                      selectedSlot
                                    )
                                  }
                                </strong>

                                <small>
                                  {
                                    formatDate(
                                      slotDate(
                                        selectedSlot
                                      )
                                    )
                                  }{" "}
                                  •{" "}
                                  {
                                    formatTime(
                                      slotTime(
                                        selectedSlot
                                      )
                                    )
                                  }
                                </small>

                              </div>

                            </div>

                            <div className="booking-confirm-actions">

                              <button
                                type="button"
                                className="button button-ghost"
                                onClick={() =>
                                  setSelectedSlot(
                                    null
                                  )
                                }
                                disabled={
                                  booking
                                }
                              >
                                Change
                              </button>

                              <button
                                type="button"
                                className="button button-primary"
                                onClick={
                                  confirmBooking
                                }
                                disabled={
                                  booking
                                }
                              >
                                {booking
                                  ? (rescheduleMode ? "Rescheduling..." : "Booking...")
                                  : (rescheduleMode ? "Request Reschedule" : "Confirm Appointment")
                                }
                              </button>
                            </div>

                          </div>
                        )}

                      </div>
                    )}

                </div>
              )
            )}

            {/* TYPING */}

            {loading && (
              <div className="chat-message chat-message-ai">

                <div className="message-bubble">

                  <div className="message-ai-icon robot-avatar" aria-label="CareFlow AI robot">
                    <span role="img" aria-label="robot">🤖</span>
                  </div>

                  <div className="typing-indicator">

                    <span></span>
                    <span></span>
                    <span></span>

                  </div>

                </div>

              </div>
            )}

            <div ref={messagesEndRef} className="chat-scroll-anchor" aria-hidden="true" />
          </div>

          {/* =================================================
              QUICK ACTIONS
              ================================================= */}

          <div className="chat-quick-actions">

            <button
              type="button"
              onClick={() =>
                setInput(
                  "I want to book an appointment with a cardiologist tomorrow at 3 PM."
                )
              }
            >
              📅 Book Appointment
            </button>

            <button
              type="button"
              onClick={() =>
                setInput(
                  "Show my upcoming appointments."
                )
              }
            >
              📋 My Appointments
            </button>

            <button
              type="button"
              onClick={() =>
                setInput(
                  "What services does CareFlow Hospital provide?"
                )
              }
            >
              ❓ Hospital FAQ
            </button>

          </div>

          {/* =================================================
              INPUT
              ================================================= */}

          <form
            className="chat-input-area"
            onSubmit={
              sendMessage
            }
          >

            <input
              value={input}
              onChange={(event) =>
                setInput(
                  event.target.value
                )
              }
              placeholder="Type your healthcare request..."
              disabled={loading}
            />

            <button
              type="submit"
              className="chat-send-button"
              disabled={
                loading ||
                !input.trim()
              }
            >
              →
            </button>

          </form>

          <div className="chat-disclaimer">
            CareFlow is designed for appointment and
            communication workflows. It does not diagnose
            medical conditions or prescribe treatment.
          </div>

        </div>

        {/* =================================================
            AI SIDEBAR
            ================================================= */}

        <aside className="ai-sidebar">

          <div className="ai-sidebar-card">

            <div className="ai-sidebar-header">

              <span>
                CAREFLOW AI
              </span>

              <strong>
                Workflow
              </strong>

            </div>

            <WorkflowStep
              number="01"
              title="Understand"
              description="SLM intent classification"
              active
            />

            <WorkflowStep
              number="02"
              title="Retrieve"
              description="RAG knowledge retrieval"
              active
            />

            <WorkflowStep
              number="03"
              title="Safety"
              description="Safety classification"
            />

            <WorkflowStep
              number="04"
              title="Execute"
              description="Workflow automation"
            />

          </div>

          <div className="ai-sidebar-card">

            <div className="ai-sidebar-header">

              <span>
                KNOWLEDGE SOURCES
              </span>

            </div>

            <KnowledgeItem>
              Hospital FAQs
            </KnowledgeItem>

            <KnowledgeItem>
              Doctor information
            </KnowledgeItem>

            <KnowledgeItem>
              Appointment database
            </KnowledgeItem>

            <KnowledgeItem>
              Patient communication
            </KnowledgeItem>

          </div>

        </aside>

      </div>
    </>
  );
}

/* =========================================================
   WORKFLOW STEP
   ========================================================= */

function WorkflowStep({
  number,
  title,
  description,
  active = false,
}) {
  return (
    <div
      className={`workflow-step ${
        active ? "active" : ""
      }`}
    >

      <div>
        {number}
      </div>

      <div>

        <strong>
          {title}
        </strong>

        <span>
          {description}
        </span>

      </div>

      <span>
        {active ? "✓" : "−"}
      </span>

    </div>
  );
}

/* =========================================================
   KNOWLEDGE ITEM
   ========================================================= */

function KnowledgeItem({
  children,
}) {
  return (
    <div className="knowledge-item">

      <span>
        ◆
      </span>

      {children}

    </div>
  );
}

/* =========================================================
   DOCTOR DASHBOARD
   ========================================================= */

function DoctorDashboard({
  user,
  onLogout,
}) {
  const [appointments, setAppointments] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const [activeTab, setActiveTab] = useState("overview");
  const [availability, setAvailability] = useState([]);
  const [availabilityLoading, setAvailabilityLoading] = useState(false);
  const [availabilityError, setAvailabilityError] = useState("");
  const [availabilityMessage, setAvailabilityMessage] = useState("");
  const [slotForm, setSlotForm] = useState({ date: getTomorrowISO(), start_time: "09:00", end_time: "12:00", slot_duration: "30" });
  const [chartYear, setChartYear] = useState(String(new Date().getFullYear()));

  async function loadAppointments() {
    setLoading(true);
    setError("");
    try {
      const data = await apiRequest("/api/appointments/");
      setAppointments(normalizeListResponse(data));
    } catch (err) {
      if (err.status === 401) { onLogout(); return; }
      setError(extractErrorMessage(err));
    } finally { setLoading(false); }
  }

  async function loadAvailability() {
    setAvailabilityLoading(true);
    setAvailabilityError("");
    try {
      // This endpoint should return the authenticated doctor's availability records.
      const data = await apiRequest("/api/doctors/availability/");
      setAvailability(normalizeListResponse(data?.results ? data : data?.availability ? { results: data.availability } : data));
    } catch (err) {
      if (err.status === 401) { onLogout(); return; }
      setAvailabilityError("Availability could not be loaded. Confirm that GET /api/doctors/availability/ is configured in Django.");
    } finally { setAvailabilityLoading(false); }
  }

  useEffect(() => { loadAppointments(); loadAvailability(); }, []);

  const statusOf = (item) => String(item?.status || "SCHEDULED").toUpperCase();
  const scheduledCount = appointments.filter((a) => ["SCHEDULED", "CONFIRMED", "RESCHEDULED"].includes(statusOf(a))).length;
  const completedCount = appointments.filter((a) => statusOf(a) === "COMPLETED").length;
  const cancelledCount = appointments.filter((a) => statusOf(a) === "CANCELLED").length;

  const monthlyStats = useMemo(() => {
    const labels = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    return labels.map((label, month) => {
      const records = appointments.filter((a) => {
        const raw = a.appointment_date || a.date;
        if (!raw) return false;
        const date = parseDateOnly(raw);
        return date && date.getFullYear() === Number(chartYear) && date.getMonth() === month;
      });
      return { label, total: records.length, scheduled: records.filter((a) => ["SCHEDULED", "CONFIRMED", "RESCHEDULED"].includes(statusOf(a))).length, completed: records.filter((a) => statusOf(a) === "COMPLETED").length, cancelled: records.filter((a) => statusOf(a) === "CANCELLED").length };
    });
  }, [appointments, chartYear]);
  const maxMonthly = Math.max(1, ...monthlyStats.map((m) => m.total));
  const currentYear = new Date().getFullYear();
  const years = Array.from(new Set([String(currentYear - 1), String(currentYear), ...appointments.map((a) => { const d = parseDateOnly(a.appointment_date || a.date); return d ? String(d.getFullYear()) : null; }).filter(Boolean)])).sort().reverse();

  async function releaseSlots(event) {
    event.preventDefault();
    setAvailabilityError(""); setAvailabilityMessage("");
    if (slotForm.end_time <= slotForm.start_time) { setAvailabilityError("End time must be later than start time."); return; }
    try {
      await apiRequest("/api/doctors/availability/", { method: "POST", body: JSON.stringify({ date: slotForm.date, start_time: slotForm.start_time, end_time: slotForm.end_time, slot_duration: Number(slotForm.slot_duration) }) });
      setAvailabilityMessage("Availability released successfully.");
      await loadAvailability();
    } catch (err) {
      setAvailabilityError(err.status === 401 ? "Your session has expired. Please sign in again." : "Could not release slots. Ensure Django supports POST /api/doctors/availability/ with date, start_time, end_time and slot_duration.");
    }
  }

  async function removeAvailability(item) {
    const id = item.id || item.pk;
    if (!id) { setAvailabilityError("This availability record has no ID, so it cannot be removed."); return; }
    setAvailabilityError(""); setAvailabilityMessage("");
    try {
      await apiRequest(`/api/doctors/availability/${encodeURIComponent(id)}/`, { method: "DELETE" });
      setAvailabilityMessage("Availability removed.");
      await loadAvailability();
    } catch (err) {
      setAvailabilityError("Could not remove this slot. Ensure Django supports DELETE /api/doctors/availability/{id}/.");
    }
  }

  return (
    <div className="dashboard-page doctor-dashboard-page">
      <DashboardTopbar user={user} onLogout={onLogout} />
      <div className="doctor-dashboard-shell">
        <div className="doctor-welcome-panel">
          <div className="doctor-welcome-copy">
            <span className="section-label">CLINICIAN PORTAL</span>
            <h1>Dr. <span>{user?.name || "Doctor"}</span></h1>
            <p>{user?.department || user?.specialization || "Healthcare"} · Your practice, appointments and availability in one place.</p>
            <div className="doctor-welcome-tags"><span>✦ CareFlow Intelligence</span><span>● Secure workspace</span></div>
          </div>
          <div className="doctor-welcome-avatar doctor-welcome-photo" aria-label={`Profile photo of Dr. ${user?.name || "Doctor"}`}>
            <img
              src={DEMO_DOCTORS.find((doctor) => (user?.name || "").toLowerCase().includes(doctor.name.toLowerCase()))?.photo || "/doctors/dr-arjun-mehta.png"}
              alt={`Dr. ${user?.name || "Doctor"}`}
              onError={(event) => { event.currentTarget.style.display = "none"; event.currentTarget.parentElement.classList.add("doctor-photo-fallback"); event.currentTarget.parentElement.insertAdjacentText("afterbegin", (user?.name || "DR").split(" ").map((part) => part[0]).join("").slice(0, 2)); }}
            />
            <i>✓</i>
          </div>
          <button className="refresh-button doctor-refresh" onClick={() => { loadAppointments(); loadAvailability(); }}>↻ Refresh data</button>
        </div>

        <div className="doctor-dashboard-tabs" role="tablist" aria-label="Doctor dashboard sections">
          {[ ["overview", "Overview"], ["appointments", "Appointments"], ["availability", "Manage availability"] ].map(([id, label]) => <button key={id} role="tab" aria-selected={activeTab === id} className={activeTab === id ? "active" : ""} onClick={() => setActiveTab(id)}>{label}</button>)}
        </div>

        {error && <div className="error-message">{error}</div>}

        {activeTab !== "availability" && <div className="overview-stat-grid doctor-stat-grid">
          <StatCard icon="▣" value={appointments.length} label="Total appointments" />
          <StatCard icon="◷" value={scheduledCount} label="Scheduled / confirmed" />
          <StatCard icon="✓" value={completedCount} label="Completed" />
          <StatCard icon="↗" value={cancelledCount} label="Cancelled" />
        </div>}

        {activeTab === "overview" && <>
          <section className="doctor-analytics-card dashboard-card">
            <div className="doctor-section-heading"><div><span className="section-label">PRACTICE ANALYTICS</span><h2>Appointments by month</h2><p>Monthly distribution from the appointments currently returned by your account.</p></div><label className="doctor-year-select">Year <select value={chartYear} onChange={(e) => setChartYear(e.target.value)}>{years.map((year) => <option key={year} value={year}>{year}</option>)}</select></label></div>
            <div className="doctor-chart-legend"><span><i className="legend-total"/>All appointments</span><span><i className="legend-scheduled"/>Scheduled</span><span><i className="legend-completed"/>Completed</span></div>
            <div className="doctor-month-chart" role="img" aria-label={`Monthly appointment counts for ${chartYear}`}>
              {monthlyStats.map((month) => <div className="doctor-month-column" key={month.label} title={`${month.label}: ${month.total} appointments`}><div className="doctor-month-bar-area"><span className="doctor-month-value">{month.total || ""}</span><div className="doctor-month-bar-stack" style={{ height: `${Math.max(month.total ? 8 : 2, month.total / maxMonthly * 100)}%` }}><span className="bar-scheduled" style={{ height: `${month.total ? month.scheduled / month.total * 100 : 0}%` }}/><span className="bar-completed" style={{ height: `${month.total ? month.completed / month.total * 100 : 0}%` }}/><span className="bar-other" style={{ height: `${month.total ? Math.max(0, month.total - month.scheduled - month.completed) / month.total * 100 : 0}%` }}/></div></div><span className="doctor-month-label">{month.label}</span></div>)}
            </div>
            <div className="doctor-chart-footnote">The chart reflects appointment records available to this login; it is not a forecast.</div>
          </section>
          <section className="dashboard-card doctor-upcoming-card">
            <div className="card-header"><div><span className="section-label">PATIENT SCHEDULE</span><h2>Recent appointments</h2></div><button className="text-button" onClick={() => setActiveTab("appointments")}>View all →</button></div>
            {loading ? <LoadingBox text="Loading appointments..."/> : appointments.length ? <DoctorAppointmentTable appointments={[...appointments].sort((a,b) => String(b.appointment_date || b.date || "").localeCompare(String(a.appointment_date || a.date || ""))).slice(0, 5)}/> : <EmptyState icon="▣" title="No appointments yet" description="When patients book appointments, they will appear here."/>}
          </section>
        </>}

        {activeTab === "appointments" && <section className="dashboard-card doctor-upcoming-card">
          <div className="card-header"><div><span className="section-label">APPOINTMENT DATABASE</span><h2>Booked appointments</h2></div><span className="table-count">{appointments.length} records</span></div>
          {loading ? <LoadingBox text="Loading patient appointments..."/> : appointments.length ? <DoctorAppointmentTable appointments={appointments}/> : <EmptyState icon="▣" title="No appointments" description="There are currently no appointments booked with you."/>}
        </section>}

        {activeTab === "availability" && <section className="doctor-availability-layout">
          <div className="dashboard-card doctor-slot-form-card"><div className="card-header"><div><span className="section-label">SLOT MANAGEMENT</span><h2>Release appointment slots</h2></div><span className="availability-icon">＋</span></div><p className="card-description">Publish the hours you are available so patients can book a suitable appointment.</p>
            <form className="doctor-slot-form" onSubmit={releaseSlots}>
              <label>Date<input type="date" min={localDateToISO(new Date())} value={slotForm.date} onChange={(e) => setSlotForm((s) => ({ ...s, date: e.target.value }))} required/></label>
              <div className="doctor-slot-form-row"><label>Start time<input type="time" value={slotForm.start_time} onChange={(e) => setSlotForm((s) => ({ ...s, start_time: e.target.value }))} required/></label><label>End time<input type="time" value={slotForm.end_time} onChange={(e) => setSlotForm((s) => ({ ...s, end_time: e.target.value }))} required/></label></div>
              <label>Appointment duration<select value={slotForm.slot_duration} onChange={(e) => setSlotForm((s) => ({ ...s, slot_duration: e.target.value }))}><option value="15">15 minutes</option><option value="20">20 minutes</option><option value="30">30 minutes</option><option value="45">45 minutes</option><option value="60">60 minutes</option></select></label>
              <div className="doctor-slot-preview"><span>PREVIEW</span><strong>{formatDate(slotForm.date)} · {slotForm.start_time || "--:--"}–{slotForm.end_time || "--:--"}</strong><small>Slots will be generated at {slotForm.slot_duration}-minute intervals.</small></div>
              {availabilityError && <div className="error-message">{availabilityError}</div>}{availabilityMessage && <div className="success-message">{availabilityMessage}</div>}
              <button className="auth-submit" type="submit">＋ Release availability</button>
            </form>
          </div>
          <div className="dashboard-card doctor-released-slots"><div className="card-header"><div><span className="section-label">YOUR CALENDAR</span><h2>Released availability</h2></div><button className="text-button" onClick={loadAvailability}>↻ Refresh</button></div>
            {availabilityLoading ? <LoadingBox text="Loading availability..."/> : availability.length ? <div className="released-slot-list">{availability.map((item) => <div className="released-slot-row" key={item.id || item.pk || `${item.date}-${item.start_time}`}><div className="released-slot-date"><strong>{formatDate(item.date || item.available_date || item.start_date)}</strong><span>{formatTime(item.start_time || item.start_time_display)} – {formatTime(item.end_time || item.end_time_display)}</span></div><span className={`availability-status ${(item.is_active === false || item.status === "CANCELLED") ? "inactive" : "active"}`}>{(item.is_active === false || item.status === "CANCELLED") ? "Inactive" : "Available"}</span><button className="remove-slot-button" onClick={() => removeAvailability(item)} aria-label="Remove availability">×</button></div>)}</div> : <EmptyState icon="◷" title="No availability released" description="Use the form to publish the dates and hours patients can book."/>}
            <p className="doctor-api-note">Availability actions require matching authenticated Django endpoints. Existing booked appointments should never be deleted when availability is changed.</p>
          </div>
        </section>}
      </div>
    </div>
  );
}

/* =========================================================
   DOCTOR APPOINTMENT TABLE
   ========================================================= */

function DoctorAppointmentTable({
  appointments,
}) {
  return (
    <div className="doctor-table-wrapper">

      <table className="doctor-table">

        <thead>

          <tr>

            <th>
              Appointment
            </th>

            <th>
              Patient
            </th>

            <th>
              Contact
            </th>

            <th>
              Date & Time
            </th>

            <th>
              Reason
            </th>

            <th>
              Status
            </th>

          </tr>

        </thead>

        <tbody>

          {appointments.map(
            (appointment) => (
              <tr
                key={
                  appointment.id ||
                  appointment.appointment_id
                }
              >

                <td>

                  <strong className="appointment-id">
                    #
                    {appointment.appointment_id ||
                      appointment.id}
                  </strong>

                </td>

                <td>

                  <div className="patient-table-person">

                    <div className="table-avatar">
                      {(
                        appointment.patient_name ||
                        "P"
                      )
                        .split(" ")
                        .map(
                          (part) =>
                            part[0]
                        )
                        .join("")
                        .slice(
                          0,
                          2
                        )}
                    </div>

                    <div>

                      <strong>
                        {
                          appointment.patient_name ||
                          "Patient"
                        }
                      </strong>

                      <span>
                        Patient
                      </span>

                    </div>

                  </div>

                </td>

                <td>

                  <div className="contact-cell">

                    <span>
                      {
                        appointment.patient_email ||
                        "—"
                      }
                    </span>

                    <span>
                      {
                        appointment.patient_mobile ||
                        "—"
                      }
                    </span>

                  </div>

                </td>

                <td>

                  <div className="date-time-cell">

                    <strong>
                      {
                        formatDate(
                          appointment.appointment_date
                        )
                      }
                    </strong>

                    <span>
                      {
                        formatTime(
                          appointment.appointment_time
                        )
                      }
                    </span>

                  </div>

                </td>

                <td>

                  <span className="reason-cell">
                    {
                      appointment.reason ||
                      "General appointment"
                    }
                  </span>

                </td>

                <td>

                  <StatusBadge
                    status={
                      appointment.status
                    }
                  />

                </td>

              </tr>
            )
          )}

        </tbody>

      </table>

    </div>
  );
}

/* =========================================================
   MAIN APP
   ========================================================= */

export default function App() {
  const [page, setPage] =
    useState("home");

  const [user, setUser] =
    useState(null);

  const [initializing, setInitializing] =
    useState(true);

  useEffect(() => {
    const storedUser =
      getStoredUser();

    const token =
      getToken();

    if (
      storedUser &&
      token
    ) {
      setUser(
        storedUser
      );

      if (
        storedUser.role ===
        "doctor"
      ) {
        setPage(
          "doctor-dashboard"
        );
      } else {
        setPage(
          "patient-dashboard"
        );
      }
    }

    setInitializing(false);
  }, []);

  function handlePatientLogin(
    loggedInUser
  ) {
    setUser(loggedInUser);
    setPage(
      "patient-dashboard"
    );
  }

  function handleDoctorLogin(
    loggedInUser
  ) {
    setUser(loggedInUser);
    setPage(
      "doctor-dashboard"
    );
  }

  function handleLogout() {
    clearAuth();
    setUser(null);
    setPage("home");
  }

  if (initializing) {
    return (
      <div className="app-loading">
        <div className="loading-logo">
          +
        </div>

        <div className="loading-spinner"></div>

        <span>
          Loading CareFlow...
        </span>
      </div>
    );
  }

  return (
    <>
      {page === "home" && (
        <HomePage
          onPatientLogin={() =>
            setPage(
              "patient-login"
            )
          }
          onDoctorLogin={() =>
            setPage(
              "doctor-login"
            )
          }
          onRegister={() =>
            setPage(
              "patient-register"
            )
          }
        />
      )}

      {page ===
        "patient-login" && (
        <PatientLoginPage
          onLogin={
            handlePatientLogin
          }
          onRegister={() =>
            setPage(
              "patient-register"
            )
          }
          onBack={() =>
            setPage("home")
          }
        />
      )}

      {page ===
        "patient-register" && (
        <PatientRegisterPage
          onRegistered={
            handlePatientLogin
          }
          onLogin={() =>
            setPage(
              "patient-login"
            )
          }
          onBack={() =>
            setPage("home")
          }
        />
      )}

      {page ===
        "doctor-login" && (
        <DoctorLoginPage
          onLogin={
            handleDoctorLogin
          }
          onBack={() =>
            setPage("home")
          }
        />
      )}

      {page ===
        "patient-dashboard" &&
        user?.role ===
          "patient" && (
          <PatientDashboard
            user={user}
            onLogout={
              handleLogout
            }
          />
        )}

      {page ===
        "doctor-dashboard" &&
        user?.role ===
          "doctor" && (
          <DoctorDashboard
            user={user}
            onLogout={
              handleLogout
            }
          />
        )}

      <style>
        {APP_STYLES}
      </style>
    </>
  );
}

/* =========================================================
   COMPLETE APPLICATION STYLES
   ========================================================= */

const APP_STYLES = `
* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  background: #04111d;
  color: #f4fbff;
}

button,
input,
textarea,
select {
  font: inherit;
}

button {
  border: 0;
}

button:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

a {
  color: inherit;
  text-decoration: none;
}

/* =========================================================
   BRAND
   ========================================================= */

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
}

.brand-mark {
  width: 40px;
  height: 40px;
  border-radius: 12px;

  display: flex;
  align-items: center;
  justify-content: center;

  background:
    linear-gradient(
      135deg,
      #16d8e5,
      #167ce8
    );

  color: white;
  font-size: 25px;
  font-weight: 800;

  box-shadow:
    0 8px 25px
    rgba(19, 184, 225, 0.25);
}

.brand strong {
  display: block;
  color: #ffffff;
  font-size: 17px;
  line-height: 1;
}

.brand span {
  display: block;
  margin-top: 4px;

  color: #55778b;
  font-size: 7px;
  font-weight: 800;
  letter-spacing: 1.2px;
}

/* =========================================================
   PUBLIC NAVBAR
   ========================================================= */

.public-page {
  min-height: 100vh;
  background:
    radial-gradient(
      circle at 70% 20%,
      rgba(0, 191, 205, 0.08),
      transparent 30%
    ),
    #04111d;
}

.public-navbar {
  position: sticky;
  top: 0;
  z-index: 50;

  height: 76px;
  padding: 0 5%;

  display: flex;
  align-items: center;
  justify-content: space-between;

  border-bottom:
    1px solid
    rgba(102, 173, 200, 0.1);

  background:
    rgba(3, 15, 27, 0.92);

  backdrop-filter: blur(16px);
}

.public-nav {
  display: flex;
  gap: 32px;
  margin-left: auto;
  margin-right: 35px;
}

.public-nav a {
  color: #7895a5;
  font-size: 12px;
  font-weight: 700;
}

.public-nav a:hover {
  color: #32ded3;
}

.nav-actions {
  display: flex;
  gap: 8px;
}

.nav-login-button,
.nav-primary-button {
  padding: 10px 15px;
  border-radius: 9px;
  cursor: pointer;

  font-size: 11px;
  font-weight: 800;
}

.nav-login-button {
  background: rgba(30, 76, 102, 0.22);
  color: #a5c0cd;
}

.nav-primary-button {
  color: #04141f;
  background: #2adfd3;
}

/* =========================================================
   HERO
   ========================================================= */

.hero-section {
  position: relative;
  min-height: 650px;

  display: flex;
  align-items: center;

  padding:
    80px 8%
    100px;

  overflow: hidden;
}

.hero-grid {
  position: absolute;
  inset: 0;

  background-image:
    linear-gradient(
      rgba(47, 139, 171, 0.035) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(47, 139, 171, 0.035) 1px,
      transparent 1px
    );

  background-size: 55px 55px;

  pointer-events: none;
}

.hero-content {
  position: relative;
  z-index: 2;
  max-width: 620px;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;

  padding: 7px 11px;

  border:
    1px solid
    rgba(42, 223, 211, 0.18);

  border-radius: 100px;

  color: #4fe0d5;
  background:
    rgba(42, 223, 211, 0.05);

  font-size: 9px;
  font-weight: 900;
  letter-spacing: 1.2px;
}

.hero-badge span {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #2de0d2;
  box-shadow:
    0 0 10px
    rgba(45, 224, 210, 0.9);
}

.hero-content h1 {
  margin:
    25px 0
    15px;

  font-size:
    clamp(48px, 6vw, 82px);

  line-height: 0.98;
  letter-spacing: -4px;
}

.hero-content h1 span {
  color: #29ddd3;
}

.hero-content > p {
  max-width: 560px;

  color: #7897a8;
  font-size: 15px;
  line-height: 1.8;
}

.hero-buttons {
  display: flex;
  gap: 10px;
  margin-top: 30px;
}

.hero-primary,
.hero-secondary {
  padding: 13px 17px;
  border-radius: 9px;
  cursor: pointer;

  font-size: 11px;
  font-weight: 900;
}

.hero-primary {
  display: inline-flex;
  align-items: center;
  gap: 15px;

  color: #03131e;
  background: #2de0d2;
}

.hero-primary span {
  font-size: 16px;
}

.hero-secondary {
  color: #a8c1cc;
  background:
    rgba(40, 80, 103, 0.2);

  border:
    1px solid
    rgba(88, 142, 166, 0.18);
}

.hero-trust {
  display: flex;
  gap: 35px;
  margin-top: 55px;
}

.hero-trust div {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.hero-trust strong {
  color: #eafaff;
  font-size: 16px;
}

.hero-trust span {
  color: #56788b;
  font-size: 9px;
}

.hero-visual {
  position: absolute;
  right: 5%;
  width: 43%;
  height: 450px;

  display: flex;
  align-items: center;
  justify-content: center;
}

.ai-orbit {
  position: relative;
  width: 390px;
  height: 390px;
}

.orbit-ring {
  position: absolute;
  inset: 20px;

  border:
    1px solid
    rgba(42, 223, 211, 0.1);

  border-radius: 50%;
}

.orbit-two {
  inset: 65px;
  border-color:
    rgba(42, 161, 230, 0.13);
}

.hero-doctor-portrait-card {
  position: absolute;
  left: 50%;
  top: 50%;
  width: min(340px, 88%);
  overflow: hidden;
  transform: translate(-50%, -50%);
  border: 1px solid rgba(45, 224, 210, 0.28);
  border-radius: 24px;
  background: #061b2a;
  box-shadow: 0 28px 90px rgba(0, 0, 0, 0.42), 0 0 50px rgba(45, 224, 210, 0.07);
}

.hero-doctor-portrait {
  display: block;
  width: 100%;
  height: 350px;
  object-fit: cover;
  object-position: center 25%;
}

.hero-doctor-caption {
  position: relative;
  padding: 18px 22px 20px;
  background: linear-gradient(135deg, rgba(5, 25, 39, 0.98), rgba(4, 37, 49, 0.98));
}

.hero-doctor-eyebrow {
  display: block;
  color: #42dcd2;
  font-size: 8px;
  font-weight: 900;
  letter-spacing: 1.5px;
}

.hero-doctor-caption strong {
  display: block;
  margin-top: 8px;
  color: #f0fbff;
  font-size: 17px;
  line-height: 1.4;
}

.hero-doctor-online {
  display: flex;
  align-items: center;
  gap: 7px;
  margin-top: 12px;
  color: #79a7b7;
  font-size: 10px;
}

.hero-doctor-online i {
  display: inline-block;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #2de0d2;
  box-shadow: 0 0 10px rgba(45, 224, 210, 0.6);
}

.hero-ai-icon {
  width: 45px;
  height: 45px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 13px;

  background:
    rgba(45, 224, 210, 0.1);

  color: #2de0d2;
  font-size: 22px;
}

.hero-ai-card > span {
  display: block;
  margin-top: 20px;

  color: #4e899d;
  font-size: 8px;
  font-weight: 900;
  letter-spacing: 1.3px;
}

.hero-ai-card > strong {
  display: block;
  margin-top: 8px;

  color: #eafaff;
  font-size: 17px;
  line-height: 1.4;
}

.hero-ai-status {
  margin-top: 20px;

  display: flex;
  align-items: center;
  gap: 6px;

  color: #5e8c9c;
  font-size: 9px;
}

.hero-ai-status span,
.online-dot,
.small-ai-status span {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #2de0d2;
}

/* =========================================================
   PUBLIC SECTIONS
   ========================================================= */

.public-section {
  padding:
    100px 8%;
}

.section-alt {
  background:
    rgba(4, 18, 30, 0.75);
}

.section-heading {
  max-width: 700px;
  margin-bottom: 45px;
}

.section-label {
  display: block;

  color: #2de0d2;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 1.5px;
}

.section-heading h2 {
  margin:
    10px 0;

  color: #f3fbff;
  font-size: 38px;
  line-height: 1.1;
  letter-spacing: -1.5px;
}

.section-heading p {
  margin: 0;

  color: #67899a;
  font-size: 13px;
  line-height: 1.7;
}

/* =========================================================
   SERVICES
   ========================================================= */

.services-grid {
  display: grid;
  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 15px;
}

.service-card {
  position: relative;

  padding: 25px;

  min-height: 190px;

  border:
    1px solid
    rgba(89, 148, 173, 0.13);

  border-radius: 15px;

  background:
    rgba(6, 25, 39, 0.65);

  transition: 0.2s ease;
}

.service-card:hover {
  transform: translateY(-3px);

  border-color:
    rgba(45, 224, 210, 0.25);
}

.service-icon {
  width: 38px;
  height: 38px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 10px;

  color: #2de0d2;

  background:
    rgba(45, 224, 210, 0.08);

  font-size: 17px;
}

.service-card h3 {
  margin:
    18px 0 8px;

  color: #f2fbff;
  font-size: 15px;
}

.service-card p {
  margin: 0;

  color: #638495;
  font-size: 11px;
  line-height: 1.7;
}

.service-arrow {
  position: absolute;
  right: 22px;
  bottom: 20px;

  color: #2de0d2;
}

/* =========================================================
   SPECIALIZATIONS
   ========================================================= */

.specialization-grid {
  display: grid;
  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  gap: 14px;
}

.specialization-card {
  padding: 20px;

  display: flex;
  gap: 14px;
  align-items: flex-start;

  border:
    1px solid
    rgba(89, 148, 173, 0.12);

  border-radius: 14px;

  background:
    rgba(6, 25, 39, 0.5);
}

.specialization-icon {
  min-width: 35px;
  width: 35px;
  height: 35px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 9px;

  color: #2de0d2;
  background:
    rgba(45, 224, 210, 0.08);
}

.specialization-card h3 {
  margin: 0 0 5px;
  font-size: 13px;
}

.specialization-card p {
  margin: 0;
  color: #648596;
  font-size: 10px;
  line-height: 1.5;
}

/* =========================================================
   DOCTORS
   ========================================================= */

.doctor-grid {
  display: grid;
  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 15px;
}

.doctor-card {
  padding: 22px;

  display: flex;
  gap: 15px;

  border:
    1px solid
    rgba(89, 148, 173, 0.13);

  border-radius: 15px;

  background:
    rgba(6, 25, 39, 0.65);
}

.doctor-avatar {
  min-width: 50px;
  width: 50px;
  height: 50px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 14px;

  color: #2de0d2;
  background:
    rgba(45, 224, 210, 0.08);

  border:
    1px solid
    rgba(45, 224, 210, 0.12);

  font-size: 13px;
  font-weight: 900;
}

.doctor-card-content {
  min-width: 0;
  flex: 1;
}

.doctor-specialty {
  color: #2de0d2;
  font-size: 8px;
  font-weight: 900;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.doctor-card h3 {
  margin:
    6px 0 5px;

  font-size: 15px;
}

.doctor-card p {
  margin: 0;

  color: #638596;
  font-size: 10px;
}

.doctor-meta {
  display: flex;
  gap: 12px;
  margin-top: 12px;
}

.doctor-meta span {
  color: #7694a2;
  font-size: 9px;
}

.doctor-fee {
  margin-top: 12px;

  color: #5c7d8d;
  font-size: 9px;
}

.doctor-fee strong {
  color: #c9f8f5;
}

/* =========================================================
   PUBLIC CTA
   ========================================================= */

.public-cta {
  margin:
    40px 8%
    80px;

  padding:
    50px;

  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;

  border:
    1px solid
    rgba(45, 224, 210, 0.15);

  border-radius: 20px;

  background:
    linear-gradient(
      135deg,
      rgba(7, 39, 53, 0.9),
      rgba(5, 23, 37, 0.9)
    );
}

.public-cta h2 {
  margin:
    10px 0;

  font-size: 36px;
  line-height: 1.1;
}

.public-cta p {
  margin: 0;
  color: #678899;
  font-size: 12px;
}

.public-footer {
  min-height: 100px;

  padding:
    30px 8%;

  display: flex;
  align-items: center;
  justify-content: space-between;

  border-top:
    1px solid
    rgba(89, 148, 173, 0.1);
}

.public-footer p {
  color: #557586;
  font-size: 10px;
}

/* =========================================================
   AUTH
   ========================================================= */

.auth-page {
  min-height: 100vh;

  position: relative;
  overflow: hidden;

  background:
    radial-gradient(
      circle at 20% 30%,
      rgba(0, 205, 214, 0.07),
      transparent 30%
    ),
    #04111d;
}

.auth-background-grid {
  position: absolute;
  inset: 0;

  background-image:
    linear-gradient(
      rgba(47, 139, 171, 0.035) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(47, 139, 171, 0.035) 1px,
      transparent 1px
    );

  background-size: 55px 55px;
}

.auth-topbar {
  position: relative;
  z-index: 2;

  height: 80px;
  padding:
    0 5%;

  display: flex;
  align-items: center;
  justify-content: space-between;

  border-bottom:
    1px solid
    rgba(89, 148, 173, 0.1);
}

.back-button {
  padding: 9px 12px;

  border-radius: 8px;

  background:
    rgba(28, 71, 95, 0.2);

  color: #7e9bab;

  cursor: pointer;

  font-size: 10px;
  font-weight: 700;
}

.auth-container {
  position: relative;
  z-index: 2;

  max-width: 1000px;

  margin:
    70px auto;

  padding: 0 25px;

  display: grid;
  grid-template-columns:
    1fr 420px;

  gap: 70px;

  align-items: center;
}

.auth-intro h1 {
  margin:
    20px 0 15px;

  font-size: 55px;
  line-height: 1;
  letter-spacing: -2px;
}

.auth-intro > p {
  max-width: 470px;

  color: #6c8a9a;
  line-height: 1.8;
  font-size: 13px;
}

.auth-feature-list {
  display: flex;
  flex-direction: column;
  gap: 13px;

  margin-top: 35px;
}

.auth-feature-list div {
  color: #7594a3;
  font-size: 11px;
}

.auth-feature-list span {
  color: #2de0d2;
  margin-right: 8px;
}

.auth-card {
  padding: 30px;

  border:
    1px solid
    rgba(89, 148, 173, 0.16);

  border-radius: 18px;

  background:
    rgba(6, 24, 38, 0.86);

  box-shadow:
    0 30px 80px
    rgba(0, 0, 0, 0.25);
}

.auth-card-header h2 {
  margin:
    9px 0 5px;

  font-size: 25px;
}

.auth-card-header p {
  margin: 0 0 25px;

  color: #658596;
  font-size: 11px;
}

.auth-form {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.auth-form label {
  display: flex;
  flex-direction: column;
  gap: 7px;

  color: #91abb8;
  font-size: 10px;
  font-weight: 700;
}

.auth-form input {
  width: 100%;

  padding: 12px 13px;

  border:
    1px solid
    rgba(89, 148, 173, 0.17);

  border-radius: 8px;

  outline: none;

  background:
    rgba(2, 14, 24, 0.8);

  color: white;

  font-size: 11px;
}

.auth-form input:focus {
  border-color:
    rgba(45, 224, 210, 0.5);

  box-shadow:
    0 0 0 3px
    rgba(45, 224, 210, 0.05);
}

.form-two-columns {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.auth-submit {
  margin-top: 5px;

  padding: 13px;

  border-radius: 8px;

  color: #03131e;
  background: #2de0d2;

  cursor: pointer;

  font-size: 11px;
  font-weight: 900;
}

.auth-switch {
  margin-top: 20px;

  display: flex;
  justify-content: center;
  gap: 5px;

  color: #607f8e;
  font-size: 10px;
}

.auth-switch button {
  color: #2de0d2;
  background: transparent;
  cursor: pointer;
  font-weight: 800;
}

.error-message {
  margin-bottom: 15px;
  padding: 11px 13px;

  border:
    1px solid
    rgba(255, 92, 107, 0.2);

  border-radius: 8px;

  color: #ff9da7;

  background:
    rgba(255, 92, 107, 0.06);

  font-size: 10px;
  line-height: 1.5;
}

/* =========================================================
   DASHBOARD
   ========================================================= */

.dashboard-page {
  min-height: 100vh;
  background:
    radial-gradient(
      circle at 80% 10%,
      rgba(0, 198, 209, 0.045),
      transparent 25%
    ),
    #04111d;
}

.dashboard-topbar {
  position: sticky;
  top: 0;
  z-index: 40;

  height: 64px;

  padding:
    0 20px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  border-bottom:
    1px solid
    rgba(89, 148, 173, 0.1);

  background:
    rgba(3, 15, 27, 0.94);

  backdrop-filter: blur(14px);
}

.dashboard-user {
  display: flex;
  align-items: center;
  gap: 9px;
}

.online-status {
  display: flex;
  align-items: center;
  gap: 5px;

  color: #45dcd3;
  font-size: 9px;
  font-weight: 800;
}

.online-status span {
  width: 5px;
  height: 5px;
  border-radius: 50%;

  background: #2de0d2;
  box-shadow:
    0 0 8px
    rgba(45, 224, 210, 0.8);
}

.user-avatar {
  width: 30px;
  height: 30px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 8px;

  color: white;
  background:
    linear-gradient(
      135deg,
      #18cbd8,
      #1679dc
    );

  font-size: 9px;
  font-weight: 900;
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.user-info strong {
  color: #e9f8fc;
  font-size: 10px;
}

.user-info span {
  color: #54798b;
  font-size: 7px;
  font-weight: 800;
}

.logout-button {
  margin-left: 10px;

  padding: 7px 11px;

  border-radius: 7px;

  background:
    rgba(28, 67, 90, 0.22);

  color: #7e9baa;

  cursor: pointer;

  font-size: 9px;
  font-weight: 700;
}

.dashboard-shell {
  display: grid;
  grid-template-columns: 215px 1fr;
  min-height: calc(100vh - 64px);
}

.dashboard-sidebar {
  padding: 25px 13px;

  border-right:
    1px solid
    rgba(89, 148, 173, 0.1);

  background:
    rgba(3, 16, 27, 0.65);
}

.sidebar-welcome {
  padding:
    0 10px
    22px;

  border-bottom:
    1px solid
    rgba(89, 148, 173, 0.08);
}

.sidebar-welcome span {
  color: #4f899a;
  font-size: 7px;
  font-weight: 900;
  letter-spacing: 1.1px;
}

.sidebar-welcome strong {
  display: block;

  margin-top: 8px;

  color: #e7f6fb;

  font-size: 15px;
  line-height: 1.4;
}

.dashboard-nav {
  display: flex;
  flex-direction: column;
  gap: 3px;

  margin-top: 17px;
}

.dashboard-nav-button {
  width: 100%;

  padding: 10px;

  display: flex;
  align-items: center;
  gap: 9px;

  border-radius: 8px;

  color: #5f7f8e;
  background: transparent;

  text-align: left;

  cursor: pointer;

  font-size: 9px;
  font-weight: 700;
}

.dashboard-nav-button:hover,
.dashboard-nav-button.active {
  color: #d9fbfa;
  background:
    rgba(45, 224, 210, 0.07);
}

.dashboard-nav-button.active {
  box-shadow:
    inset 2px 0 #2de0d2;
}

.dashboard-nav-icon {
  width: 20px;
  text-align: center;
  color: #2de0d2;
}

.sidebar-ai-card {
  margin-top: 35px;
  padding: 15px;

  border:
    1px solid
    rgba(45, 224, 210, 0.11);

  border-radius: 12px;

  background:
    rgba(45, 224, 210, 0.035);
}

.sidebar-ai-icon {
  color: #2de0d2;
  font-size: 16px;
}

.sidebar-ai-card strong {
  display: block;
  margin-top: 7px;

  font-size: 11px;
}

.sidebar-ai-card p {
  color: #55798a;
  font-size: 8px;
  line-height: 1.6;
}

.sidebar-ai-card button {
  color: #2de0d2;
  background: transparent;
  cursor: pointer;

  font-size: 8px;
  font-weight: 900;
}

.dashboard-main {
  min-width: 0;
  padding: 30px;
  max-width: 1400px;
}

.dashboard-heading {
  margin-bottom: 25px;

  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
}

.dashboard-heading h1 {
  margin:
    7px 0 5px;

  font-size: 32px;
  letter-spacing: -1.3px;
}

.dashboard-heading h1 span {
  color: #2de0d2;
}

.dashboard-heading p {
  margin: 0;
  color: #5d7d8c;
  font-size: 10px;
}

.dashboard-ai-button,
.refresh-button {
  padding: 10px 13px;

  border-radius: 8px;

  background:
    rgba(45, 224, 210, 0.08);

  border:
    1px solid
    rgba(45, 224, 210, 0.14);

  color: #45ddd4;

  cursor: pointer;

  font-size: 9px;
  font-weight: 900;
}

/* =========================================================
   DASHBOARD CARDS
   ========================================================= */

.dashboard-card {
  padding: 20px;

  border:
    1px solid
    rgba(89, 148, 173, 0.11);

  border-radius: 14px;

  background:
    rgba(6, 24, 38, 0.62);
}

.card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 15px;

  margin-bottom: 20px;
}

.card-header h2 {
  margin:
    7px 0 0;

  font-size: 16px;
}

.card-description {
  color: #638596;
  font-size: 10px;
  line-height: 1.7;
}

.text-button {
  color: #2de0d2;
  background: transparent;
  cursor: pointer;

  font-size: 9px;
  font-weight: 800;
}

.overview-stat-grid {
  display: grid;
  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 12px;

  margin-bottom: 15px;
}

.stat-card {
  padding: 16px;

  display: flex;
  align-items: center;
  gap: 12px;

  border:
    1px solid
    rgba(89, 148, 173, 0.11);

  border-radius: 12px;

  background:
    rgba(6, 24, 38, 0.55);
}

.stat-icon {
  width: 35px;
  height: 35px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 9px;

  color: #2de0d2;
  background:
    rgba(45, 224, 210, 0.08);
}

.stat-card strong {
  display: block;
  color: #f2fbff;
  font-size: 18px;
}

.stat-card span {
  display: block;
  margin-top: 3px;
  color: #5b7c8c;
  font-size: 8px;
}

.overview-grid {
  display: grid;
  grid-template-columns:
    1.3fr 1fr;

  gap: 15px;

  margin-bottom: 15px;
}

.small-ai-status {
  display: flex;
  align-items: center;
  gap: 5px;

  color: #4cd9d0;
  font-size: 8px;
}

.large-ai-button {
  width: 100%;

  margin-top: 18px;
  padding: 13px;

  display: flex;
  align-items: center;
  gap: 10px;

  border-radius: 9px;

  color: #4edfd6;

  background:
    rgba(45, 224, 210, 0.07);

  border:
    1px solid
    rgba(45, 224, 210, 0.13);

  cursor: pointer;

  font-size: 10px;
  font-weight: 800;
  text-align: left;
}

.large-ai-button span {
  font-size: 16px;
}

.large-ai-button strong {
  margin-left: auto;
}

/* =========================================================
   APPOINTMENT PREVIEW
   ========================================================= */

.appointment-preview {
  display: flex;
  align-items: center;
  gap: 13px;

  padding: 12px;

  border-radius: 10px;

  background:
    rgba(2, 15, 26, 0.6);
}

.appointment-date-box {
  min-width: 48px;
  width: 48px;
  padding: 8px;

  display: flex;
  flex-direction: column;
  align-items: center;

  border-radius: 9px;

  background:
    rgba(45, 224, 210, 0.08);
}

.appointment-date-box span {
  color: #2de0d2;
  font-size: 7px;
  font-weight: 900;
  text-transform: uppercase;
}

.appointment-date-box strong {
  margin-top: 2px;
  font-size: 17px;
}

.appointment-preview-info {
  flex: 1;
}

.appointment-specialty {
  color: #2de0d2;
  font-size: 8px;
  font-weight: 800;
}

.appointment-preview-info h3 {
  margin:
    3px 0;

  font-size: 12px;
}

.appointment-preview-info p {
  margin: 0;

  color: #7693a1;
  font-size: 9px;
}

/* =========================================================
   STATUS
   ========================================================= */

.status-badge {
  display: inline-flex;
  padding: 5px 8px;

  border-radius: 6px;

  font-size: 7px;
  font-weight: 900;
  letter-spacing: 0.5px;
}

.status-scheduled {
  color: #4fe0d6;
  background:
    rgba(45, 224, 210, 0.08);
}

.status-rescheduled {
  color: #e2c46e;
  background:
    rgba(226, 196, 110, 0.08);
}

.status-cancelled {
  color: #ff8e9b;
  background:
    rgba(255, 95, 111, 0.08);
}

.status-completed {
  color: #86c8ff;
  background:
    rgba(94, 172, 255, 0.08);
}

/* =========================================================
   MINI SERVICES
   ========================================================= */

.services-preview-card {
  margin-bottom: 15px;
}

.mini-services-grid {
  display: grid;
  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  gap: 10px;
}

.mini-service {
  padding: 12px;

  display: flex;
  gap: 9px;

  border:
    1px solid
    rgba(89, 148, 173, 0.08);

  border-radius: 9px;
}

.mini-service-icon {
  color: #2de0d2;
}

.mini-service strong {
  display: block;
  font-size: 9px;
}

.mini-service span {
  display: block;
  margin-top: 4px;

  color: #587888;
  font-size: 7px;
  line-height: 1.5;
}

/* =========================================================
   APPOINTMENT LIST
   ========================================================= */

.appointment-list {
  display: flex;
  flex-direction: column;
}

.appointment-row {
  padding:
    13px 0;

  display: grid;
  grid-template-columns:
    150px
    1.1fr
    1fr
    90px;

  gap: 15px;
  align-items: center;

  border-bottom:
    1px solid
    rgba(89, 148, 173, 0.08);
}

.appointment-row:last-child {
  border-bottom: 0;
}

.appointment-row-date {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.appointment-row-date strong {
  color: #e8f7fc;
  font-size: 10px;
}

.appointment-row-date span {
  color: #2de0d2;
  font-size: 9px;
  font-weight: 800;
}

.appointment-row-doctor {
  display: flex;
  align-items: center;
  gap: 9px;
}

.table-avatar {
  width: 30px;
  height: 30px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 8px;

  color: #2de0d2;
  background:
    rgba(45, 224, 210, 0.08);

  font-size: 8px;
  font-weight: 900;
}

.appointment-row-doctor strong {
  display: block;
  font-size: 10px;
}

.appointment-row-doctor span {
  display: block;
  margin-top: 3px;

  color: #557789;
  font-size: 8px;
}

.appointment-row-reason span {
  color: #4d7182;
  font-size: 7px;
  text-transform: uppercase;
}

.appointment-row-reason p {
  margin: 4px 0 0;

  color: #8ba4b1;
  font-size: 8px;
}

/* =========================================================
   SERVICES / DOCTORS DASHBOARD
   ========================================================= */

.dashboard-services {
  grid-template-columns:
    repeat(3, minmax(0, 1fr));
}

.dashboard-doctor-grid {
  grid-template-columns:
    repeat(2, minmax(0, 1fr));
}

.specialization-filter {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  margin-bottom: 18px;
}

.filter-button {
  padding: 8px 11px;

  border-radius: 7px;

  color: #668594;

  background:
    rgba(28, 65, 87, 0.18);

  border:
    1px solid
    rgba(89, 148, 173, 0.09);

  cursor: pointer;

  font-size: 8px;
  font-weight: 800;
}

.filter-button.active {
  color: #03131e;
  background: #2de0d2;
  border-color: #2de0d2;
}

/* =========================================================
   AI CHAT
   ========================================================= */

.ai-status-pill {
  display: flex;
  align-items: center;
  gap: 6px;

  padding: 8px 11px;

  border-radius: 7px;

  color: #54dcd4;

  background:
    rgba(45, 224, 210, 0.05);

  border:
    1px solid
    rgba(45, 224, 210, 0.1);

  font-size: 8px;
  font-weight: 800;
}

.ai-status-pill span {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #2de0d2;
}

.ai-chat-layout {
  display: grid;
  grid-template-columns:
    minmax(0, 1fr)
    225px;

  gap: 14px;

  align-items: start;
}

.chat-card {
  min-width: 0;

  border:
    1px solid
    rgba(89, 148, 173, 0.13);

  border-radius: 15px;

  background:
    rgba(5, 21, 34, 0.75);

  overflow: hidden;
}

.chat-header {
  height: 64px;

  padding:
    0 15px;

  display: flex;
  align-items: center;
  gap: 10px;

  border-bottom:
    1px solid
    rgba(89, 148, 173, 0.08);
}

.ai-icon,
.message-ai-icon {
  width: 29px;
  height: 29px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 8px;

  color: #03131e;
  background: #2de0d2;

  font-weight: 900;
}

.message-ai-icon {
  min-width: 24px;
  width: 24px;
  height: 24px;
  font-size: 10px;
}

.chat-header-text {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.chat-header-text strong {
  font-size: 10px;
}

.chat-header-text span {
  color: #567788;
  font-size: 7px;
}

.online-dot {
  margin-left: auto;
}

.chat-messages {
  min-height: 480px;
  max-height: 600px;

  padding: 18px;

  overflow-y: auto;

  display: flex;
  flex-direction: column;
  gap: 14px;
}

.chat-message {
  max-width: 100%;
}

.chat-message-user {
  display: flex;
  justify-content: flex-end;
}

.chat-message-user .message-bubble {
  max-width: 75%;

  padding: 10px 13px;

  border-radius:
    12px 12px 3px 12px;

  color: #c8f5f3;

  background:
    rgba(34, 135, 139, 0.19);

  border:
    1px solid
    rgba(45, 224, 210, 0.1);

  font-size: 9px;
  line-height: 1.6;
}

.chat-message-ai .message-bubble {
  max-width: 85%;

  display: flex;
  align-items: flex-start;
  gap: 7px;
}

.message-content {
  padding:
    10px 12px;

  border:
    1px solid
    rgba(89, 148, 173, 0.1);

  border-radius:
    3px 12px 12px 12px;

  color: #a5bfca;

  background:
    rgba(10, 31, 46, 0.85);

  font-size: 9px;
  line-height: 1.6;
}

/* =========================================================
   CHAT BOOKING OPTIONS
   ========================================================= */

.chat-booking-options {
  width: calc(100% - 31px);

  margin:
    10px 0
    0 31px;

  padding: 13px;

  border:
    1px solid
    rgba(42, 224, 211, 0.14);

  border-radius: 13px;

  background:
    rgba(5, 22, 35, 0.72);
}

.chat-booking-title {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 10px;

  margin-bottom: 10px;
}

.chat-booking-title > div {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.chat-booking-title span {
  color: #27e0d2;
  font-size: 7px;
  font-weight: 900;
  letter-spacing: 1.1px;
}

.chat-booking-title strong {
  color: #ffffff;
  font-size: 11px;
}

.chat-booking-title small {
  color: #5fded4;

  background:
    rgba(39, 224, 210, 0.07);

  border:
    1px solid
    rgba(39, 224, 210, 0.12);

  padding: 5px 7px;

  border-radius: 6px;

  white-space: nowrap;

  font-size: 7px;
}

.chat-slot-grid {
  display: grid;
  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 8px;
}

.chat-slot-card {
  position: relative;

  padding: 11px;

  border:
    1px solid
    rgba(112, 161, 188, 0.13);

  border-radius: 10px;

  background:
    rgba(3, 15, 26, 0.86);

  transition: 0.2s ease;
}

.chat-slot-card:hover {
  border-color:
    rgba(39, 224, 210, 0.4);

  transform:
    translateY(-1px);
}

.chat-slot-selected {
  border-color: #27e0d2;

  background:
    rgba(39, 224, 210, 0.07);

  box-shadow:
    0 0 0 1px
    rgba(39, 224, 210, 0.15);
}

.chat-slot-top {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-bottom: 7px;
}

.slot-period {
  color: #5dded4;
  font-size: 7px;
  font-weight: 900;
  letter-spacing: 1px;
}

.slot-selected-badge {
  color: #27e0d2;
  font-size: 7px;
  font-weight: 900;
}

.chat-slot-doctor {
  color: #ffffff;
  font-size: 10px;
  font-weight: 900;
}

.chat-slot-department {
  margin-top: 3px;

  color: #22d6ea;
  font-size: 8px;
  font-weight: 800;
}

.chat-slot-date {
  margin-top: 8px;

  color: #7897a6;
  font-size: 8px;
}

.chat-slot-time {
  margin-top: 3px;

  color: #2de0d2;
  font-size: 14px;
  font-weight: 900;
}

.chat-slot-fee {
  margin-top: 4px;

  color: #91aab6;
  font-size: 8px;
}

.chat-slot-button {
  width: 100%;

  margin-top: 9px;
  padding: 7px;

  border:
    1px solid
    rgba(39, 224, 210, 0.18);

  border-radius: 6px;

  background:
    rgba(39, 224, 210, 0.05);

  color: #6be5dc;

  cursor: pointer;

  font-size: 7px;
  font-weight: 900;
}

.chat-slot-button:hover {
  background:
    rgba(39, 224, 210, 0.12);
}

.chat-slot-button.selected {
  color: #03131e;
  background: #27e0d2;
  border-color: #27e0d2;
}

/* =========================================================
   BOOKING CONFIRM
   ========================================================= */

.booking-confirm-panel {
  margin-top: 10px;
  padding: 10px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 10px;

  border:
    1px solid
    rgba(39, 224, 210, 0.24);

  border-radius: 9px;

  background:
    rgba(39, 224, 210, 0.05);
}

.booking-confirm-info {
  display: flex;
  align-items: center;
  gap: 8px;
}

.booking-confirm-icon {
  width: 28px;
  height: 28px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 7px;

  color: #2de0d2;
  background:
    rgba(39, 224, 210, 0.1);

  font-size: 12px;
  font-weight: 900;
}

.booking-confirm-info > div:last-child {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.booking-confirm-info span {
  color: #598394;
  font-size: 6px;
  font-weight: 800;
  letter-spacing: 0.8px;
}

.booking-confirm-info strong {
  color: #ffffff;
  font-size: 9px;
}

.booking-confirm-info small {
  color: #8ba3af;
  font-size: 7px;
}

.booking-confirm-actions {
  display: flex;
  gap: 5px;
}

.button {
  padding: 8px 10px;

  border-radius: 6px;

  cursor: pointer;

  font-size: 7px;
  font-weight: 900;
}

.button-primary {
  color: #03131e;
  background: #2de0d2;
}

.button-ghost {
  color: #8da6b3;
  background:
    rgba(35, 71, 91, 0.3);
}

/* =========================================================
   CHAT QUICK ACTIONS
   ========================================================= */

.chat-quick-actions {
  padding:
    9px 13px;

  display: flex;
  gap: 6px;

  border-top:
    1px solid
    rgba(89, 148, 173, 0.08);
}

.chat-quick-actions button {
  padding: 7px 9px;

  border-radius: 6px;

  color: #7395a5;

  background:
    rgba(29, 63, 82, 0.25);

  cursor: pointer;

  font-size: 7px;
  font-weight: 700;
}

.chat-quick-actions button:hover {
  color: #b8f6f1;
  background:
    rgba(45, 224, 210, 0.07);
}

/* =========================================================
   CHAT INPUT
   ========================================================= */

.chat-input-area {
  padding:
    10px 13px;

  display: flex;
  gap: 8px;

  border-top:
    1px solid
    rgba(89, 148, 173, 0.08);
}

.chat-input-area input {
  flex: 1;

  min-width: 0;

  padding: 11px;

  border:
    1px solid
    rgba(89, 148, 173, 0.13);

  border-radius: 8px;

  outline: none;

  background:
    rgba(3, 15, 26, 0.8);

  color: #dffaff;

  font-size: 9px;
}

.chat-input-area input:focus {
  border-color:
    rgba(45, 224, 210, 0.35);
}

.chat-send-button {
  width: 38px;

  border-radius: 8px;

  color: #03131e;
  background: #2de0d2;

  cursor: pointer;

  font-size: 17px;
}

.chat-disclaimer {
  padding:
    0 13px
    11px;

  color: #385a6b;
  font-size: 6px;
  line-height: 1.5;
}

/* =========================================================
   TYPING
   ========================================================= */

.typing-indicator {
  padding:
    11px 12px;

  display: flex;
  gap: 4px;

  border-radius:
    3px 12px 12px 12px;

  background:
    rgba(10, 31, 46, 0.85);
}

.typing-indicator span {
  width: 4px;
  height: 4px;

  border-radius: 50%;

  background: #2de0d2;

  animation:
    careflowTyping
    1.2s infinite
    ease-in-out;
}

.typing-indicator span:nth-child(2) {
  animation-delay: 0.15s;
}

.typing-indicator span:nth-child(3) {
  animation-delay: 0.3s;
}

@keyframes careflowTyping {
  0%,
  60%,
  100% {
    opacity: 0.3;
    transform: translateY(0);
  }

  30% {
    opacity: 1;
    transform: translateY(-3px);
  }
}

/* =========================================================
   AI SIDEBAR
   ========================================================= */

.ai-sidebar {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.ai-sidebar-card {
  padding: 14px;

  border:
    1px solid
    rgba(89, 148, 173, 0.1);

  border-radius: 13px;

  background:
    rgba(5, 22, 35, 0.65);
}

.ai-sidebar-header {
  display: flex;
  flex-direction: column;
  gap: 3px;

  margin-bottom: 13px;
}

.ai-sidebar-header span {
  color: #2de0d2;
  font-size: 7px;
  font-weight: 900;
  letter-spacing: 1px;
}

.ai-sidebar-header strong {
  color: #dcecf1;
  font-size: 11px;
}

.workflow-step {
  padding: 8px 0;

  display: grid;
  grid-template-columns:
    25px 1fr 15px;

  gap: 6px;
  align-items: center;

  border-bottom:
    1px solid
    rgba(89, 148, 173, 0.06);
}

.workflow-step:last-child {
  border-bottom: 0;
}

.workflow-step > div:first-child {
  width: 22px;
  height: 22px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 6px;

  color: #527687;
  background:
    rgba(32, 69, 88, 0.25);

  font-size: 6px;
  font-weight: 900;
}

.workflow-step.active
  > div:first-child {
  color: #2de0d2;
  background:
    rgba(45, 224, 210, 0.08);
}

.workflow-step > div:nth-child(2) {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.workflow-step strong {
  color: #9ab7c4;
  font-size: 8px;
}

.workflow-step span {
  color: #47697a;
  font-size: 6px;
}

.workflow-step > span:last-child {
  color: #3c697a;
  font-size: 8px;
}

.workflow-step.active
  > span:last-child {
  color: #2de0d2;
}

.knowledge-item {
  padding: 8px 0;

  display: flex;
  gap: 7px;

  color: #648696;

  font-size: 7px;
}

.knowledge-item span {
  color: #2de0d2;
  font-size: 6px;
}

/* =========================================================
   DOCTOR DASHBOARD
   ========================================================= */

.doctor-dashboard-shell {
  max-width: 1500px;
  padding: 30px;
}

.table-count {
  padding: 6px 9px;

  border-radius: 6px;

  color: #58dcd3;
  background:
    rgba(45, 224, 210, 0.06);

  font-size: 7px;
  font-weight: 800;
}

.doctor-table-wrapper {
  width: 100%;
  overflow-x: auto;
}

.doctor-table {
  width: 100%;
  border-collapse: collapse;
}

.doctor-table th {
  padding:
    10px 8px;

  color: #4d7181;

  border-bottom:
    1px solid
    rgba(89, 148, 173, 0.1);

  text-align: left;

  font-size: 7px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.doctor-table td {
  padding:
    12px 8px;

  border-bottom:
    1px solid
    rgba(89, 148, 173, 0.06);

  vertical-align: middle;
}

.appointment-id {
  color: #5e8b9d;
  font-size: 8px;
}

.patient-table-person {
  display: flex;
  align-items: center;
  gap: 8px;
}

.patient-table-person strong {
  display: block;
  color: #dceef3;
  font-size: 9px;
}

.patient-table-person span {
  display: block;
  margin-top: 3px;
  color: #527384;
  font-size: 7px;
}

.contact-cell,
.date-time-cell {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.contact-cell span {
  color: #7c99a7;
  font-size: 7px;
}

.date-time-cell strong {
  color: #d9eef4;
  font-size: 8px;
}

.date-time-cell span {
  color: #2de0d2;
  font-size: 8px;
  font-weight: 800;
}

.reason-cell {
  display: block;
  max-width: 160px;

  color: #7895a2;

  font-size: 7px;
  line-height: 1.5;
}

/* =========================================================
   LOADING / EMPTY
   ========================================================= */

.loading-box {
  min-height: 180px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  gap: 10px;

  color: #5b7c8c;
  font-size: 9px;
}

.loading-spinner {
  width: 24px;
  height: 24px;

  border:
    2px solid
    rgba(45, 224, 210, 0.12);

  border-top-color: #2de0d2;

  border-radius: 50%;

  animation:
    careflowSpin
    0.8s linear
    infinite;
}

@keyframes careflowSpin {
  to {
    transform: rotate(360deg);
  }
}

.empty-state {
  min-height: 190px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  text-align: center;
}

.empty-icon {
  width: 38px;
  height: 38px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 10px;

  color: #2de0d2;
  background:
    rgba(45, 224, 210, 0.07);

  font-size: 15px;
}

.empty-state h3 {
  margin:
    12px 0 5px;

  font-size: 12px;
}

.empty-state p {
  max-width: 330px;

  margin: 0;

  color: #567788;

  font-size: 8px;
  line-height: 1.6;
}

/* =========================================================
   APP LOADING
   ========================================================= */

.app-loading {
  min-height: 100vh;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  gap: 13px;

  background: #04111d;
  color: #648696;

  font-size: 9px;
}

.loading-logo {
  width: 45px;
  height: 45px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 13px;

  color: white;

  background:
    linear-gradient(
      135deg,
      #16d8e5,
      #167ce8
    );

  font-size: 26px;
  font-weight: 900;
}

/* =========================================================
   RESPONSIVE
   ========================================================= */


/* =========================================================
   DOCTOR PORTAL — ANALYTICS, SCHEDULING AND PROFILE POLISH
   ========================================================= */
.doctor-dashboard-shell { width: 100%; max-width: 1600px; margin: 0 auto; padding: 30px clamp(18px, 3vw, 48px) 48px; }
.doctor-welcome-panel { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 190px; padding: 30px 32px; margin-bottom: 22px; overflow: hidden; border: 1px solid rgba(45,224,210,.15); border-radius: 22px; background: radial-gradient(ellipse at 88% 12%, rgba(26,170,187,.16), transparent 36%), linear-gradient(135deg, rgba(8,34,49,.96), rgba(4,18,30,.98)); }
.doctor-welcome-panel:after { content:""; position:absolute; inset:0; pointer-events:none; opacity:.32; background-image:linear-gradient(rgba(47,139,171,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(47,139,171,.04) 1px,transparent 1px); background-size:28px 28px; }
.doctor-welcome-copy { position:relative; z-index:1; }
.doctor-welcome-copy h1 { margin:10px 0 8px; font-size:clamp(30px,4vw,46px); letter-spacing:-1.8px; }
.doctor-welcome-copy h1 span { color:#2de0d2; }
.doctor-welcome-copy p { margin:0; color:#7d9caf; font-size:13px; line-height:1.7; }
.doctor-welcome-tags { display:flex; flex-wrap:wrap; gap:9px; margin-top:18px; }
.doctor-welcome-tags span { padding:7px 10px; border:1px solid rgba(45,224,210,.12); border-radius:99px; color:#8eb3bf; background:rgba(45,224,210,.045); font-size:10px; }
.doctor-welcome-avatar { position:relative; z-index:1; display:grid; place-items:center; flex:0 0 104px; width:104px; height:104px; border-radius:30px; color:#041520; background:linear-gradient(140deg,#35e5d6,#158cce); box-shadow:0 12px 42px rgba(17,191,205,.15); font-size:27px; font-weight:900; }
.doctor-welcome-avatar i { position:absolute; right:-5px; bottom:-5px; display:grid; place-items:center; width:27px; height:27px; border:4px solid #071722; border-radius:50%; color:#041520; background:#43e4b1; font-size:12px; font-style:normal; }
.doctor-refresh { position:relative; z-index:1; align-self:flex-start; }
.doctor-dashboard-tabs { display:flex; gap:7px; margin:0 0 22px; padding:5px; width:max-content; max-width:100%; border:1px solid rgba(89,148,173,.12); border-radius:13px; background:rgba(5,22,35,.8); }
.doctor-dashboard-tabs button { padding:11px 16px; border-radius:9px; color:#7c9aaa; background:transparent; cursor:pointer; font-size:12px; font-weight:800; white-space:nowrap; }
.doctor-dashboard-tabs button.active { color:#04151f; background:#2de0d2; box-shadow:0 5px 20px rgba(45,224,210,.12); }
.doctor-stat-grid { grid-template-columns:repeat(4,minmax(0,1fr)); gap:14px; margin-bottom:20px; }
.doctor-stat-grid .stat-card { min-width:0; border-radius:17px; padding:20px; background:linear-gradient(145deg,rgba(7,29,43,.96),rgba(5,21,33,.94)); }
.doctor-stat-grid .stat-card strong { font-size:25px; }
.doctor-stat-grid .stat-card span { font-size:10px; }
.doctor-analytics-card,.doctor-upcoming-card { margin-bottom:20px; padding:24px; border-radius:19px; }
.doctor-section-heading { display:flex; justify-content:space-between; align-items:flex-start; gap:18px; }
.doctor-section-heading h2,.doctor-upcoming-card .card-header h2,.doctor-slot-form-card .card-header h2,.doctor-released-slots .card-header h2 { margin:7px 0 6px; font-size:20px; letter-spacing:-.5px; }
.doctor-section-heading p { margin:0; color:#6f91a2; font-size:11px; line-height:1.6; }
.doctor-year-select { display:flex; align-items:center; gap:8px; color:#6f91a2; font-size:11px; }
.doctor-year-select select,.doctor-slot-form select,.doctor-slot-form input { min-width:0; padding:10px 11px; border:1px solid rgba(89,148,173,.2); border-radius:9px; outline:none; color:#dff7fb; background:#071d2b; }
.doctor-year-select select:focus,.doctor-slot-form select:focus,.doctor-slot-form input:focus { border-color:#2de0d2; box-shadow:0 0 0 3px rgba(45,224,210,.08); }
.doctor-chart-legend { display:flex; flex-wrap:wrap; gap:16px; margin:22px 0 8px; color:#7393a3; font-size:10px; }
.doctor-chart-legend span { display:flex; align-items:center; gap:7px; }
.doctor-chart-legend i { width:8px; height:8px; display:inline-block; border-radius:3px; }
.legend-total { background:#2de0d2; }.legend-scheduled { background:#1689d5; }.legend-completed { background:#54d69b; }
.doctor-month-chart { display:grid; grid-template-columns:repeat(12,minmax(0,1fr)); gap:clamp(5px,1.3vw,17px); height:220px; padding-top:10px; border-bottom:1px solid rgba(89,148,173,.15); background:repeating-linear-gradient(to bottom,transparent 0,transparent 53px,rgba(89,148,173,.08) 54px,transparent 55px); }
.doctor-month-column { display:flex; flex-direction:column; min-width:0; align-items:center; justify-content:flex-end; }
.doctor-month-bar-area { display:flex; flex:1; width:100%; flex-direction:column; justify-content:flex-end; align-items:center; min-height:0; }
.doctor-month-value { min-height:16px; margin-bottom:4px; color:#b9d8e2; font-size:10px; font-weight:800; }
.doctor-month-bar-stack { display:flex; flex-direction:column; justify-content:flex-start; overflow:hidden; width:min(100%,30px); min-height:2px; border-radius:7px 7px 2px 2px; background:rgba(45,224,210,.07); box-shadow:0 0 20px rgba(45,224,210,.04); }
.doctor-month-bar-stack span { display:block; width:100%; min-height:0; }.bar-scheduled { background:linear-gradient(180deg,#21c9d3,#147fc5); }.bar-completed { background:#4ed6a0; }.bar-other { background:#e6ad5a; }
.doctor-month-label { margin:9px 0 10px; color:#7090a0; font-size:10px; }
.doctor-chart-footnote { margin-top:14px; color:#547586; font-size:10px; line-height:1.6; }
.doctor-availability-layout { display:grid; grid-template-columns:minmax(280px,.9fr) minmax(0,1.1fr); align-items:start; gap:18px; }
.doctor-slot-form-card,.doctor-released-slots { padding:23px; border-radius:19px; }
.availability-icon { display:grid; place-items:center; width:36px; height:36px; border-radius:11px; color:#2de0d2; background:rgba(45,224,210,.09); font-size:23px; }
.doctor-slot-form { display:flex; flex-direction:column; gap:15px; margin-top:20px; }
.doctor-slot-form label { display:flex; flex-direction:column; gap:7px; color:#92adba; font-size:11px; font-weight:700; }
.doctor-slot-form input,.doctor-slot-form select { width:100%; min-height:42px; color-scheme:dark; }
.doctor-slot-form-row { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
.doctor-slot-preview { display:flex; flex-direction:column; gap:7px; padding:14px; border:1px solid rgba(45,224,210,.13); border-radius:12px; background:rgba(45,224,210,.04); }
.doctor-slot-preview span { color:#2de0d2; font-size:9px; font-weight:900; letter-spacing:1px; }.doctor-slot-preview strong { color:#e2f5f9; font-size:12px; }.doctor-slot-preview small { color:#7193a2; font-size:10px; }
.doctor-slot-form .auth-submit { width:100%; margin-top:2px; }
.success-message { padding:11px 13px; border:1px solid rgba(68,216,158,.2); border-radius:9px; color:#67e0b0; background:rgba(68,216,158,.07); font-size:11px; }
.released-slot-list { display:flex; flex-direction:column; gap:9px; margin-top:16px; }
.released-slot-row { display:flex; align-items:center; gap:12px; padding:13px; border:1px solid rgba(89,148,173,.12); border-radius:12px; background:rgba(4,20,32,.6); }
.released-slot-date { display:flex; flex:1; min-width:0; flex-direction:column; gap:6px; }.released-slot-date strong { color:#d8eff5; font-size:11px; }.released-slot-date span { color:#7293a3; font-size:10px; }
.availability-status { padding:6px 8px; border-radius:99px; font-size:9px; font-weight:900; }.availability-status.active { color:#5be2b0; background:rgba(68,216,158,.08); }.availability-status.inactive { color:#ff9b9b; background:rgba(255,107,107,.08); }
.remove-slot-button { width:27px; height:27px; border-radius:8px; color:#ff9b9b; background:rgba(255,107,107,.08); cursor:pointer; font-size:18px; }
.doctor-api-note { margin:18px 0 0; color:#58798a; font-size:10px; line-height:1.6; }
.doctor-photo-avatar { overflow:hidden; padding:0; background:#092a3c; }
.doctor-photo-avatar { flex: 0 0 78px; width: 78px; height: 92px; border-radius: 16px; }
.doctor-photo-avatar img { object-position: center top; }
.doctor-photo-fallback { display:flex; align-items:center; justify-content:center; color:#2de0d2; font-weight:900; font-size:22px; }
.doctor-welcome-photo { overflow:hidden; padding:0; position:relative; }
.doctor-welcome-photo img { width:100%; height:100%; object-fit:cover; object-position:center top; border-radius:inherit; display:block; }
.doctor-welcome-photo i { position:absolute; right:0; bottom:0; }
.user-avatar-photo { padding:0; overflow:hidden; }
.user-avatar-photo img { width:100%; height:100%; display:block; object-fit:cover; object-position:center top; border-radius:inherit; }

.doctor-photo-avatar img { display:block; width:100%; height:100%; object-fit:cover; }
.doctor-photo-fallback { padding:0; color:#2de0d2; background:rgba(45,224,210,.08); }

@media (max-width: 1100px) {
  .hero-visual {
    opacity: 0.3;
    right: -100px;
  }

  .services-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .specialization-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .doctor-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .ai-chat-layout {
    grid-template-columns: 1fr;
  }

  .ai-sidebar {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 850px) {
  .public-nav {
    display: none;
  }

  .hero-section {
    padding:
      70px 6%;
  }

  .hero-visual {
    display: none;
  }

  .auth-container {
    grid-template-columns: 1fr;
    max-width: 600px;
  }

  .auth-intro {
    text-align: center;
  }

  .auth-feature-list {
    align-items: center;
  }

  .dashboard-shell {
    grid-template-columns: 1fr;
  }

  .dashboard-sidebar {
    border-right: 0;
    border-bottom:
      1px solid
      rgba(89, 148, 173, 0.1);

    padding: 12px;
  }

  .sidebar-welcome,
  .sidebar-ai-card {
    display: none;
  }

  .dashboard-nav {
    flex-direction: row;
    overflow-x: auto;
  }

  .dashboard-nav-button {
    min-width: max-content;
  }

  .dashboard-main {
    padding: 20px;
  }

  .mini-services-grid {
    grid-template-columns:
      repeat(2, 1fr);
  }
}

@media (max-width: 650px) {
  .public-navbar {
    padding: 0 15px;
  }

  .nav-login-button {
    display: none;
  }

  .hero-content h1 {
    font-size: 45px;
    letter-spacing: -2px;
  }

  .hero-buttons {
    flex-direction: column;
  }

  .hero-primary,
  .hero-secondary {
    justify-content: center;
  }

  .hero-trust {
    gap: 15px;
    flex-wrap: wrap;
  }

  .public-section {
    padding:
      65px 20px;
  }

  .section-heading h2 {
    font-size: 29px;
  }

  .services-grid,
  .specialization-grid,
  .doctor-grid {
    grid-template-columns: 1fr;
  }

  .public-cta {
    margin:
      20px 15px
      50px;

    padding: 30px 20px;

    flex-direction: column;
    align-items: flex-start;
  }

  .public-cta h2 {
    font-size: 29px;
  }

  .public-footer {
    padding:
      25px 20px;

    flex-direction: column;
    align-items: flex-start;
    gap: 15px;
  }

  .auth-topbar {
    padding:
      0 15px;
  }

  .auth-container {
    margin:
      35px auto;

    padding:
      0 15px;
  }

  .auth-intro h1 {
    font-size: 42px;
  }

  .auth-card {
    padding: 22px;
  }

  .form-two-columns {
    grid-template-columns: 1fr;
  }

  .dashboard-topbar {
    padding: 0 10px;
  }

  .dashboard-user .online-status,
  .user-info {
    display: none;
  }

  .dashboard-main,
  .doctor-dashboard-shell {
    padding: 15px;
  }

  .dashboard-heading {
    align-items: flex-start;
    flex-direction: column;
  }

  .dashboard-heading h1 {
    font-size: 27px;
  }

  .overview-stat-grid {
    grid-template-columns: 1fr;
  }

  .overview-grid {
    grid-template-columns: 1fr;
  }

  .mini-services-grid {
    grid-template-columns: 1fr;
  }

  .dashboard-doctor-grid {
    grid-template-columns: 1fr;
  }

  .ai-sidebar {
    display: none;
  }

  .chat-messages {
    min-height: 420px;
    padding: 12px;
  }

  .chat-slot-grid {
    grid-template-columns: 1fr;
  }

  .chat-booking-options {
    width: calc(100% - 31px);
  }

  .booking-confirm-panel {
    flex-direction: column;
    align-items: stretch;
  }

  .booking-confirm-actions {
    width: 100%;
  }

  .booking-confirm-actions button {
    flex: 1;
  }

  .chat-quick-actions {
    overflow-x: auto;
  }

  .chat-quick-actions button {
    white-space: nowrap;
  }

  .appointment-row {
    grid-template-columns: 1fr;
    gap: 8px;
  }

  .doctor-table {
    min-width: 800px;
  }
}

/* =========================================================
   CAREFLOW AI CHAT REDESIGN
   Scrollable conversation + anchored composer + robot avatar
   ========================================================= */
.careflow-chat-layout {
  align-items: stretch;
  min-width: 0;
}

.careflow-chat-layout .chat-card {
  display: flex;
  flex-direction: column;
  min-width: 0;
  height: clamp(560px, calc(100vh - 245px), 820px);
  max-height: calc(100vh - 190px);
  overflow: hidden;
  border: 1px solid rgba(45, 224, 210, 0.14);
  border-radius: 20px;
  background:
    radial-gradient(ellipse at 12% 0%, rgba(17, 117, 139, 0.11), transparent 38%),
    linear-gradient(160deg, #061824 0%, #04111c 65%, #051522 100%);
  box-shadow: 0 22px 65px rgba(0, 0, 0, 0.18);
}

.careflow-chat-layout .chat-header {
  flex: 0 0 auto;
  height: 76px;
  padding: 0 22px;
  gap: 13px;
  background: rgba(3, 17, 28, 0.76);
  border-bottom: 1px solid rgba(112, 180, 201, 0.11);
}

.careflow-chat-layout .chat-header-text strong {
  color: #f1fbff;
  font-size: 14px;
  letter-spacing: -0.01em;
}

.careflow-chat-layout .chat-header-text span {
  color: #7295a8;
  font-size: 11px;
}

.robot-avatar {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  background: linear-gradient(145deg, #2de0d2, #1398e8) !important;
  color: #042033 !important;
  box-shadow: 0 7px 20px rgba(22, 194, 208, 0.18);
  overflow: hidden;
}

.careflow-chat-layout .ai-icon.robot-avatar {
  width: 43px;
  height: 43px;
  border-radius: 14px;
  font-size: 23px;
}

.robot-avatar span {
  line-height: 1;
  filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.16));
}

.careflow-chat-layout .chat-messages {
  flex: 1 1 auto;
  min-height: 0;
  height: auto;
  overflow-y: auto;
  overscroll-behavior: contain;
  scroll-behavior: smooth;
  padding: 24px clamp(14px, 3vw, 32px);
  gap: 18px;
  background-image: radial-gradient(rgba(91, 155, 176, 0.08) 0.7px, transparent 0.7px);
  background-size: 19px 19px;
  scrollbar-width: thin;
  scrollbar-color: rgba(45, 224, 210, 0.3) transparent;
}

.careflow-chat-layout .chat-messages::-webkit-scrollbar { width: 7px; }
.careflow-chat-layout .chat-messages::-webkit-scrollbar-thumb {
  background: rgba(45, 224, 210, 0.28);
  border-radius: 20px;
}

.careflow-chat-layout .chat-message {
  max-width: 100%;
  animation: careflow-message-in 220ms ease-out both;
}

.careflow-chat-layout .chat-message-ai { align-self: flex-start; }
.careflow-chat-layout .chat-message-user { align-self: flex-end; }

.careflow-chat-layout .message-bubble {
  gap: 10px;
  max-width: min(780px, 88%);
}

.careflow-chat-layout .message-ai-icon.robot-avatar {
  width: 34px;
  height: 34px;
  min-width: 34px;
  border-radius: 11px;
  font-size: 18px;
  margin-top: 2px;
}

.careflow-chat-layout .message-content {
  padding: 15px 17px;
  border: 1px solid rgba(100, 166, 190, 0.13);
  border-radius: 5px 17px 17px 17px;
  background: rgba(12, 33, 48, 0.93);
  color: #c6dce8;
  font-size: 13px;
  line-height: 1.75;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.careflow-chat-layout .chat-message-user .message-bubble {
  justify-content: flex-end;
}

.careflow-chat-layout .chat-message-user .message-content {
  border-color: rgba(45, 224, 210, 0.18);
  border-radius: 17px 5px 17px 17px;
  background: linear-gradient(135deg, rgba(12, 115, 137, 0.42), rgba(11, 72, 103, 0.55));
  color: #edffff;
}

.careflow-chat-layout .chat-quick-actions {
  flex: 0 0 auto;
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
  padding: 13px 20px 11px;
  border-top: 1px solid rgba(112, 180, 201, 0.09);
  background: rgba(3, 17, 28, 0.96);
}

.careflow-chat-layout .chat-quick-actions button {
  padding: 10px 13px;
  border: 1px solid rgba(107, 169, 191, 0.13);
  border-radius: 10px;
  background: #0a2030;
  color: #8bb6c9;
  font-size: 11px;
  transition: border-color 160ms ease, color 160ms ease, transform 160ms ease;
}

.careflow-chat-layout .chat-quick-actions button:hover {
  color: #40eee0;
  border-color: rgba(45, 224, 210, 0.35);
  transform: translateY(-1px);
}

.careflow-chat-layout .chat-input-area {
  flex: 0 0 auto;
  align-items: center;
  gap: 11px;
  padding: 0 20px 12px;
  border-top: 0;
  background: rgba(3, 17, 28, 0.96);
}

.careflow-chat-layout .chat-input-area input {
  min-height: 52px;
  padding: 15px 17px;
  border-color: rgba(107, 169, 191, 0.17);
  border-radius: 13px;
  background: #04131f;
  color: #e8fbff;
  font-size: 13px;
}

.careflow-chat-layout .chat-input-area input::placeholder { color: #55788b; }
.careflow-chat-layout .chat-input-area input:focus {
  border-color: rgba(45, 224, 210, 0.62);
  box-shadow: 0 0 0 3px rgba(45, 224, 210, 0.07);
}

.careflow-chat-layout .chat-send-button {
  width: 52px;
  min-width: 52px;
  height: 52px;
  border-radius: 13px;
  color: #03131e;
  background: linear-gradient(135deg, #2de0d2, #159edb);
  box-shadow: 0 7px 20px rgba(21, 158, 219, 0.16);
}

.careflow-chat-layout .chat-send-button:disabled { opacity: 0.45; cursor: not-allowed; }

.careflow-chat-layout .chat-disclaimer {
  flex: 0 0 auto;
  padding: 0 20px 15px;
  background: rgba(3, 17, 28, 0.96);
  color: #547486;
  font-size: 10px;
}

.careflow-chat-layout .typing-indicator { padding: 13px 16px; }
.careflow-chat-layout .chat-scroll-anchor { width: 1px; height: 1px; flex: 0 0 1px; }

@keyframes careflow-message-in {
  from { opacity: 0; transform: translateY(7px); }
  to { opacity: 1; transform: translateY(0); }
}

@media (max-width: 900px) {
  .careflow-chat-layout .chat-card {
    height: calc(100dvh - 250px);
    min-height: 500px;
    max-height: none;
  }
  .careflow-chat-layout .chat-messages { padding: 17px 13px; }
  .careflow-chat-layout .chat-quick-actions { flex-wrap: nowrap; overflow-x: auto; padding: 11px 13px; }
  .careflow-chat-layout .chat-quick-actions button { white-space: nowrap; }
  .careflow-chat-layout .chat-input-area { padding: 0 13px 10px; }
  .careflow-chat-layout .chat-disclaimer { padding: 0 13px 12px; }
  .careflow-chat-layout .message-bubble { max-width: 96%; }
}

@media (max-width: 1000px) {
  .doctor-stat-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
  .doctor-availability-layout { grid-template-columns:1fr; }
  .doctor-welcome-panel { flex-wrap:wrap; }
}
@media (max-width: 650px) {
  .doctor-dashboard-shell { padding:18px 12px 30px; }
  .doctor-welcome-panel { padding:22px 18px; gap:16px; }
  .doctor-welcome-avatar { flex-basis:66px; width:66px; height:66px; border-radius:20px; font-size:20px; }
  .doctor-refresh { margin-left:auto; }
  .doctor-dashboard-tabs { width:100%; overflow-x:auto; }
  .doctor-dashboard-tabs button { padding:10px 12px; font-size:10px; }
  .doctor-analytics-card,.doctor-upcoming-card,.doctor-slot-form-card,.doctor-released-slots { padding:17px 13px; }
  .doctor-section-heading { flex-direction:column; }
  .doctor-month-chart { gap:3px; height:175px; }
  .doctor-month-label { font-size:8px; }
  .doctor-month-value { font-size:8px; }
  .doctor-chart-legend { gap:9px; font-size:9px; }
  .released-slot-row { gap:7px; padding:10px 8px; }
  .availability-status { font-size:8px; }
}

@media (prefers-reduced-motion: reduce) {
  .careflow-chat-layout .chat-message { animation: none; }
  .careflow-chat-layout .chat-messages { scroll-behavior: auto; }
}

/* Keep the chat on one viewport: only the conversation pane scrolls. */
.careflow-chat-layout {
  align-items: stretch;
  min-height: 0;
}
.careflow-chat-layout .chat-card {
  height: min(740px, calc(100dvh - 150px));
  min-height: 420px;
  max-height: calc(100dvh - 150px);
}
.careflow-chat-layout .chat-messages {
  min-height: 0;
  flex: 1 1 0;
  overscroll-behavior-y: contain;
  scroll-padding-bottom: 18px;
}
.careflow-chat-layout .chat-booking-options {
  margin-top: 8px;
}
.careflow-chat-layout .chat-slot-grid {
  gap: 8px;
}
.careflow-chat-layout .chat-slot-card {
  padding: 11px;
}
.careflow-chat-layout .message-content {
  line-height: 1.55;
  overflow-wrap: anywhere;
}
.careflow-chat-layout .chat-disclaimer {
  line-height: 1.4;
}
@media (max-height: 800px) {
  .careflow-chat-layout .chat-card {
    height: calc(100dvh - 130px);
    max-height: calc(100dvh - 130px);
    min-height: 390px;
  }
  .careflow-chat-layout .chat-header { height: 68px; }
  .careflow-chat-layout .chat-messages { padding-top: 14px; padding-bottom: 14px; gap: 12px; }
  .careflow-chat-layout .chat-quick-actions { padding-top: 8px; padding-bottom: 8px; }
  .careflow-chat-layout .chat-disclaimer { padding-bottom: 9px; }
}
@media (max-width: 900px) {
  .careflow-chat-layout .chat-card {
    height: calc(100dvh - 190px);
    min-height: 390px;
    max-height: none;
  }
}
`;