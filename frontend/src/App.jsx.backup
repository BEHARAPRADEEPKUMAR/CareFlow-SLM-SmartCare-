/* =========================================================
   AUTH HELPERS
   ========================================================= */

function getToken() {
  return localStorage.getItem(TOKEN_KEY);
}

function getStoredUser() {
  try {
    const raw = localStorage.getItem(USER_KEY);

    if (!raw) {
      return null;
    }

    return JSON.parse(raw);
  } catch {
    return null;
  }
}

function saveAuth(token, user) {
  localStorage.setItem(TOKEN_KEY, token);
  localStorage.setItem(USER_KEY, JSON.stringify(user));
}

function clearAuth() {
  localStorage.removeItem(TOKEN_KEY);
  localStorage.removeItem(USER_KEY);
}

/* =========================================================
   API HELPER
   ========================================================= */

async function apiRequest(endpoint, options = {}) {
  const token = getToken();

  const headers = {
    "Content-Type": "application/json",
    ...(options.headers || {}),
  };

  if (token) {
    headers.Authorization = `Token ${token}`;
  }

  const response = await fetch(
    `${API_BASE}${endpoint}`,
    {
      ...options,
      headers,
    }
  );

  let data = null;

  try {
    data = await response.json();
  } catch {
    data = null;
  }

  if (!response.ok) {
    const error = new Error(
      extractErrorMessage({
        response: data,
        status: response.status,
      })
    );

    error.status = response.status;
    error.data = data;

    throw error;
  }

  return data;
}

/* =========================================================
   ERROR HELPERS
   ========================================================= */

function extractErrorMessage(error) {
  if (!error) {
    return "Something went wrong.";
  }

  if (typeof error === "string") {
    return error;
  }

  if (error.message && error.message !== "Something went wrong.") {
    return error.message;
  }

  const data =
    error.response ||
    error.data ||
    error;

  if (typeof data === "string") {
    return data;
  }

  if (data?.detail) {
    return String(data.detail);
  }

  if (data?.message) {
    return String(data.message);
  }

  if (data?.error) {
    return String(data.error);
  }

  if (data?.errors) {
    return flattenErrors(data.errors);
  }

  return "Something went wrong. Please try again.";
}

function flattenErrors(errors) {
  if (!errors) {
    return "Invalid request.";
  }

  if (typeof errors === "string") {
    return errors;
  }

  if (Array.isArray(errors)) {
    return errors.join(", ");
  }

  if (typeof errors === "object") {
    return Object.entries(errors)
      .map(([key, value]) => {
        const message = Array.isArray(value)
          ? value.join(", ")
          : typeof value === "object"
          ? JSON.stringify(value)
          : String(value);

        return `${key}: ${message}`;
      })
      .join(" | ");
  }

  return "Invalid request.";
}

/* =========================================================
   GENERAL HELPERS
   ========================================================= */

function getNestedValue(object, paths) {
  for (const path of paths) {
    const parts = path.split(".");
    let current = object;

    for (const part of parts) {
      if (
        current === null ||
        current === undefined
      ) {
        current = undefined;
        break;
      }

      current = current[part];
    }

    if (
      current !== undefined &&
      current !== null &&
      current !== ""
    ) {
      return current;
    }
  }

  return null;
}

function cleanAssistantText(text) {
  if (!text) {
    return "";
  }

  return String(text)
    .replace(/BOOK_APPOINTMENTSAFE/gi, "")
    .replace(/BOOK_APPOINTMENT/gi, "")
    .replace(/\bSAFE\b/gi, "")
    .replace(/\s{2,}/g, " ")
    .trim();
}

/* =========================================================
   DATE HELPERS
   ========================================================= */

function padNumber(number) {
  return String(number).padStart(2, "0");
}

function localDateToISO(date) {
  return [
    date.getFullYear(),
    padNumber(date.getMonth() + 1),
    padNumber(date.getDate()),
  ].join("-");
}

function parseDateOnly(value) {
  if (!value) {
    return null;
  }

  const text = String(value).trim();

  const match = text.match(
    /^(\d{4})-(\d{1,2})-(\d{1,2})/
  );

  if (match) {
    const year = Number(match[1]);
    const month = Number(match[2]) - 1;
    const day = Number(match[3]);

    return new Date(
      year,
      month,
      day
    );
  }

  const parsed = new Date(text);

  if (Number.isNaN(parsed.getTime())) {
    return null;
  }

  return parsed;
}

function normalizeSlotDate(value) {
  if (!value) {
    return "";
  }

  const parsed = parseDateOnly(value);

  if (!parsed) {
    return String(value).slice(0, 10);
  }

  return localDateToISO(parsed);
}

function formatDate(value) {
  if (!value) {
    return "Date unavailable";
  }

  const parsed = parseDateOnly(value);

  if (!parsed) {
    return String(value);
  }

  return parsed.toLocaleDateString(
    "en-IN",
    {
      day: "2-digit",
      month: "short",
      year: "numeric",
    }
  );
}

function getTomorrowISO() {
  const tomorrow = new Date();

  tomorrow.setDate(
    tomorrow.getDate() + 1
  );

  return localDateToISO(tomorrow);
}

/* =========================================================
   TIME HELPERS
   ========================================================= */

function normalizeSlotTime(value) {
  if (!value) {
    return "";
  }

  let text = String(value)
    .trim()
    .toLowerCase()
    .replace(/\./g, "");

  const ampmMatch = text.match(
    /^(\d{1,2})(?::(\d{1,2}))?\s*(am|pm)$/
  );

  if (ampmMatch) {
    let hour = Number(ampmMatch[1]);
    const minute = Number(
      ampmMatch[2] || 0
    );

    const period = ampmMatch[3];

    if (period === "am" && hour === 12) {
      hour = 0;
    }

    if (period === "pm" && hour !== 12) {
      hour += 12;
    }

    return `${padNumber(hour)}:${padNumber(
      minute
    )}:00`;
  }

  const colonMatch = text.match(
    /^(\d{1,2}):(\d{1,2})(?::(\d{1,2}))?$/
  );

  if (colonMatch) {
    return `${padNumber(
      Number(colonMatch[1])
    )}:${padNumber(
      Number(colonMatch[2])
    )}:${padNumber(
      Number(colonMatch[3] || 0)
    )}`;
  }

  return text;
}

function timeToMinutes(value) {
  if (!value) {
    return null;
  }

  const normalized =
    normalizeSlotTime(value);

  const match = normalized.match(
    /^(\d{2}):(\d{2})/
  );

  if (!match) {
    return null;
  }

  return (
    Number(match[1]) * 60 +
    Number(match[2])
  );
}

function formatTime(value) {
  if (!value) {
    return "Time unavailable";
  }

  const normalized =
    normalizeSlotTime(value);

  const minutes =
    timeToMinutes(normalized);

  if (minutes === null) {
    return String(value);
  }

  let hour = Math.floor(
    minutes / 60
  );

  const minute = minutes % 60;

  const period =
    hour >= 12 ? "PM" : "AM";

  hour = hour % 12;

  if (hour === 0) {
    hour = 12;
  }

  return `${hour}:${padNumber(
    minute
  )} ${period}`;
}

function parseRequestedTime(text) {
  if (!text) {
    return null;
  }

  const value = String(text)
    .toLowerCase()
    .replace(/\./g, "");

  const match = value.match(
    /(?:at|around|by|for)?\s*(\d{1,2})(?::(\d{2}))?\s*(am|pm)\b/
  );

  if (!match) {
    return null;
  }

  let hour = Number(match[1]);

  const minute = Number(
    match[2] || 0
  );

  const period = match[3];

  if (period === "am" && hour === 12) {
    hour = 0;
  }

  if (period === "pm" && hour !== 12) {
    hour += 12;
  }

  return (
    hour * 60 +
    minute
  );
}

/* =========================================================
   FEE HELPERS
   ========================================================= */

function slotFee(slot) {
  return getNestedValue(slot, [
    "consultation_fee",
    "fee",
    "doctor.consultation_fee",
    "doctor.fee",
  ]);
}

function formatFee(value) {
  if (
    value === null ||
    value === undefined ||
    value === ""
  ) {
    return "";
  }

  const number = Number(
    String(value).replace(/[^\d.]/g, "")
  );

  if (Number.isNaN(number)) {
    return String(value);
  }

  return `₹${number.toLocaleString(
    "en-IN"
  )}`;
}

/* =========================================================
   SLOT HELPERS
   ========================================================= */

function slotDoctorId(slot) {
  return getNestedValue(slot, [
    "doctor_id",
    "doctor.id",
    "doctor",
  ]);
}

function slotDoctorName(slot) {
  return (
    getNestedValue(slot, [
      "doctor_name",
      "doctor.name",
      "name",
    ]) || "Doctor"
  );
}

function slotDepartment(slot) {
  return (
    getNestedValue(slot, [
      "department",
      "department_name",
      "doctor.department.name",
      "specialization",
    ]) || "General Medicine"
  );
}

function slotDate(slot) {
  return getNestedValue(slot, [
    "date",
    "appointment_date",
    "appointmentDate",
  ]);
}

function slotTime(slot) {
  return getNestedValue(slot, [
    "time",
    "appointment_time",
    "appointmentTime",
  ]);
}

/* =========================================================
   CHAT RESPONSE HELPERS
   ========================================================= */

function extractChatText(data) {
  if (!data) {
    return "";
  }

  const candidates = [
    data.response,
    data.message,
    data.answer,
    data.reply,
    data.text,
    data.result?.response,
    data.result?.message,
    data.result?.answer,
    data.result?.reply,
    data.result?.text,
  ];

  for (const candidate of candidates) {
    if (
      typeof candidate === "string" &&
      candidate.trim()
    ) {
      return cleanAssistantText(
        candidate
      );
    }
  }

  return "";
}

/* =========================================================
   BOOKING OPTIONS EXTRACTION
   ========================================================= */

function getBookingOptions(data) {
  if (!data) {
    return [];
  }

  const candidates = [
    data.booking_options,
    data.bookingOptions,
    data.available_slots,
    data.availableSlots,
    data.options,
    data.slots,

    data.result?.booking_options,
    data.result?.bookingOptions,
    data.result?.available_slots,
    data.result?.availableSlots,
    data.result?.options,
    data.result?.slots,

    data.data?.booking_options,
    data.data?.bookingOptions,
    data.data?.available_slots,
    data.data?.availableSlots,
    data.data?.options,
    data.data?.slots,
  ];

  for (const candidate of candidates) {
    if (Array.isArray(candidate)) {
      return candidate;
    }
  }

  return [];
}

/* =========================================================
   RANK BOOKING OPTIONS
   ========================================================= */

function rankBookingOptions(
  options,
  requestedMinutes
) {
  if (!Array.isArray(options)) {
    return [];
  }

  const usable = options.filter(
    (option) =>
      slotDoctorId(option) &&
      slotDate(option) &&
      slotTime(option)
  );

  const sorted = [...usable].sort(
    (a, b) => {
      const aMinutes =
        timeToMinutes(
          slotTime(a)
        );

      const bMinutes =
        timeToMinutes(
          slotTime(b)
        );

      if (
        requestedMinutes !== null &&
        requestedMinutes !== undefined
      ) {
        const aDifference =
          aMinutes === null
            ? Number.MAX_SAFE_INTEGER
            : Math.abs(
                aMinutes -
                  requestedMinutes
              );

        const bDifference =
          bMinutes === null
            ? Number.MAX_SAFE_INTEGER
            : Math.abs(
                bMinutes -
                  requestedMinutes
              );

        if (
          aDifference !==
          bDifference
        ) {
          return (
            aDifference -
            bDifference
          );
        }
      }

      return (
        (aMinutes || 0) -
        (bMinutes || 0)
      );
    }
  );

  /*
   * Maximum 3 slots per doctor.
   * Maximum 6 slots total.
   */
  const doctorCounts = {};
  const result = [];

  for (const option of sorted) {
    const doctorId =
      String(
        slotDoctorId(option)
      );

    doctorCounts[doctorId] =
      doctorCounts[doctorId] || 0;

    if (
      doctorCounts[doctorId] >= 3
    ) {
      continue;
    }

    doctorCounts[doctorId] += 1;
    result.push(option);

    if (result.length >= 6) {
      break;
    }
  }

  return result;
}

/* =========================================================
   NORMALIZE APPOINTMENT RESPONSE
   ========================================================= */

function normalizeListResponse(data) {
  if (Array.isArray(data)) {
    return data;
  }

  if (Array.isArray(data?.results)) {
    return data.results;
  }

  if (Array.isArray(data?.data)) {
    return data.data;
  }

  if (Array.isArray(data?.appointments)) {
    return data.appointments;
  }

  return [];
}

